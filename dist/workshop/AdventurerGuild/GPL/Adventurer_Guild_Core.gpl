function Adventurer_Guild_Chart_Candidate(
	coordinate PalacePoint,
	coordinate Frontier,
	coordinate Extents,
	integer Percent
) is coordinate
declare
	integer PX, PY, FX, FY, Width, Height, DX, DY, TX, TY;
	float Scale, AxisScale, SampleScale;
begin
	PX = $GetX(PalacePoint);
	PY = $GetY(PalacePoint);
	FX = $GetX(Frontier);
	FY = $GetY(Frontier);
	Width = $GetX(Extents);
	Height = $GetY(Extents);
	if ((Percent < 40) || (Percent > 60))
		return $MakeCoord(-1, -1);
	if ((PX < 0) || (PY < 0) || (PX >= Width) || (PY >= Height))
		return $MakeCoord(-1, -1);
	if ((FX < 0) || (FY < 0) || (FX >= Width) || (FY >= Height))
		return $MakeCoord(-1, -1);
	DX = FX - PX;
	DY = FY - PY;
	if ((DX == 0) && (DY == 0))
		return $MakeCoord(-1, -1);



	Scale = -1.0;
	if (DX > 0)
		Scale = ((Width - 1 - FX) * 1.0) / DX;
	else if (DX < 0)
		Scale = (FX * -1.0) / DX;
	if (DY != 0)
		begin
			if (DY > 0)
				AxisScale = ((Height - 1 - FY) * 1.0) / DY;
			else
				AxisScale = (FY * -1.0) / DY;
			if ((Scale < 0.0) || (AxisScale < Scale))
				Scale = AxisScale;
		end
	if (Scale <= 0.0)
		return $MakeCoord(-1, -1);
	SampleScale = Scale * Percent / 100.0;
	TX = FX + DX * SampleScale;
	TY = FY + DY * SampleScale;
	if ((TX < 0) || (TY < 0) || (TX >= Width) || (TY >= Height))
		return $MakeCoord(-1, -1);
	if ((TX == FX) && (TY == FY))
		return $MakeCoord(-1, -1);
	return $MakeCoord(TX, TY);
end




function Adventurer_Guild_Chart_Point_In_List(coordinate Point, list Points) is boolean
declare
	coordinate Other;
	integer Index;
begin
	Index = 1;
	while ((Index <= $ListSize(Points)) && (Index <= 16)) do
		begin
			Other = $ListMember(Points, Index);
			if (($GetX(Point) == $GetX(Other)) && ($GetY(Point) == $GetY(Other)))
				return True;
			Index += 1;
		end
	return False;
end


function Adventurer_Guild_Chart_Arrived(agent Hero, coordinate Point) is boolean
declare
begin


	return ($DistanceBetweenCoords($LocationOf(Hero), Point) < 15);
end





function Adventurer_Guild_Chart_Unexplored(agent Guild, coordinate Point) is boolean
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	return ($MM_MapFog($GetUnitPlayerNumber(Guild), Point) == 0);
end

function Adventurer_Guild_Chart_Find_Destination(agent Guild) is coordinate
declare
	list Buildings, Palaces, SeenCandidates;
	agent Palace;
	coordinate Origin, SearchOrigin, Extents, Frontier, Point;
	integer Cursor, Attempt, Status, Sample, Player;
	boolean CanFindPath;
	float Cost;
begin
	$ListObjects(Guild, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);
	Palaces = $ListTitles(Buildings, "Palace");
	if ($ListSize(Palaces) == 0)
		return $MakeCoord(-1, -1);
	Palace = $ListMember(Palaces, 1);
	Origin = $LocationOf(Palace);
	Extents = $GetBoardExtents();
	Player = $GetUnitPlayerNumber(Guild);




	if ($GetNearestHiddenCoord(Palace, SearchOrigin) == False)
		return $MakeCoord(-1, -1);
	Cursor = 0;
	Attempt = 0;
	while (Attempt < 8) do
		begin
			Attempt += 1;


			Status = $MM_MapNextFrontier(Player, SearchOrigin, Cursor, 256, Frontier);
			if ((Status == -1) || (Status == 2))
				return $MakeCoord(-1, -1);
			if (Status == 1)
				begin
					Sample = 0;
					while (Sample < 2) do
						begin
							Sample += 1;
							Point = $Adventurer_Guild_Chart_Candidate(
								Origin, Frontier, Extents, $RandomNumber(21) + 40);
							if (($GetX(Point) >= 0) && ($GetY(Point) >= 0))
								if ($Adventurer_Guild_Chart_Point_In_List(Point, SeenCandidates) == False)
									begin
										SeenCandidates << Point;
										if ($Adventurer_Guild_Chart_Unexplored(Guild, Point))
											begin
												CanFindPath = False;
												Cost = $PathCost($GetEntranceLoc(Guild), Point,
													"check_buildings", CanFindPath);
												if (CanFindPath)
													return Point;
											end
									end
						end
				end
		end
	return $MakeCoord(-1, -1);
end






function Adventurer_Guild_Chart_Sync_Head(agent Guild)
declare
	integer Key;
	agent Applicant;
begin
	$Adventurer_Guild_Ensure_Quest_State(Guild);
	Key = 0;
	if ($ListSize(Guild's "AGChartKeys") > 0)
		Key = $ListMember(Guild's "AGChartKeys", 1);
	if ((Key > 0) && (Guild's "AGRowKey" == Key) &&
		(Guild's "AGGuild" == Guild))
		return;
	Applicant = Guild's "AGApplicant";
	if ($IsValidGamePiece(Applicant))
		$Adventurer_Guild_Remove_Applicant(Guild, Applicant);
	Guild's "AGAvailableQuests" -= Guild;
	Guild's "AGGuild" = $NullAgent();
	Guild's "AGQuestKind" = 0;
	Guild's "AGApplicant" = $NullAgent();
	Guild's "AGClaimant" = $NullAgent();
	if (Key <= 0)
		return;
	Guild's "AGRowKey" = Key;
	Guild's "AGGuild" = Guild;
	Guild's "AGQuestKind" = 4;
	Guild's "AGChartPoint" = $ListMember(Guild's "AGChartPoints", 1);
	Guild's "AGDestination" = $NullAgent();
	Guild's "AGDestination2" = $NullAgent();
	Guild's "AGStage" = 0;
	Guild's "AGObjectiveComplete" = False;
	Guild's "AGPaid" = False;
	Guild's "AGName" = "Chart the Wilds";
	Guild's "AGGoal" = "Explore uncharted territory";
	Guild's "AGReward" = 200;
	Guild's "AGAvailableQuests" << Guild;
end

function Adventurer_Guild_Chart_Prune(agent Guild)
declare
	list Keys, Points;
	coordinate Point;
	integer Index;
	boolean Changed;
begin
	Index = 1;
	Changed = False;
	while (Index <= $ListSize(Guild's "AGChartKeys")) do
		begin
			Point = $ListMember(Guild's "AGChartPoints", Index);
			if ($Adventurer_Guild_Chart_Unexplored(Guild, Point))
				begin
					Keys << $ListMember(Guild's "AGChartKeys", Index);
					Points << Point;
				end
			else
				Changed = True;
			Index += 1;
		end
	if (Changed)
		begin
			Guild's "AGChartKeys" = Keys;
			Guild's "AGChartPoints" = Points;
			$Adventurer_Guild_Chart_Sync_Head(Guild);
			$Adventurer_Guild_Publish_Rows(Guild);
		end
end

function Adventurer_Guild_Create_Chart(agent Guild) is boolean
declare
	coordinate Point;
	integer Key;
begin
	Point = $Adventurer_Guild_Chart_Find_Destination(Guild);
	if (($GetX(Point) < 0) || ($GetY(Point) < 0))
		return False;
	Key = $Adventurer_Guild_Allocate_Row_Key(Guild);
	if (Key <= 0)
		return False;
	Guild's "AGChartKeys" << Key;
	Guild's "AGChartPoints" << Point;
	$Adventurer_Guild_Chart_Sync_Head(Guild);
	return True;
end

function Adventurer_Guild_Ensure_Guild_State(agent Guild)
declare
begin
	if ($HasAttribute("AGAvailableQuests", Guild) == False)
		$AddAttribute(Guild, "AGAvailableQuests", "list");

	if ($HasAttribute("AGActiveQuests", Guild) == False)
		$AddAttribute(Guild, "AGActiveQuests", "list");

	if ($HasAttribute("AGApplicants", Guild) == False)
		$AddAttribute(Guild, "AGApplicants", "list");

	if ($HasAttribute("AGRefreshing", Guild) == False)
		$AddAttribute(Guild, "AGRefreshing", "boolean", False);

	if ($HasAttribute("AGRevision", Guild) == False)
		$AddAttribute(Guild, "AGRevision", "integer", 0);
	if ($HasAttribute("AGNextRowKey", Guild) == False)
		$AddAttribute(Guild, "AGNextRowKey", "integer", 1);
	if ($HasAttribute("AGUIRowKeys", Guild) == False)
		$AddAttribute(Guild, "AGUIRowKeys", "list");
	if ($HasAttribute("AGUIRowKinds", Guild) == False)
		$AddAttribute(Guild, "AGUIRowKinds", "list");
	if ($HasAttribute("AGUIRowRewards", Guild) == False)
		$AddAttribute(Guild, "AGUIRowRewards", "list");
	if ($HasAttribute("AGUIReady", Guild) == False)
		$AddAttribute(Guild, "AGUIReady", "boolean", False);
	if ($HasAttribute("AGChartKeys", Guild) == False)
		$AddAttribute(Guild, "AGChartKeys", "list");
	if ($HasAttribute("AGChartPoints", Guild) == False)
		$AddAttribute(Guild, "AGChartPoints", "list");

	if ($HasAttribute("AGProofOfferVisible", Guild) == False)
		$AddAttribute(Guild, "AGProofOfferVisible", "boolean", True);

	if ($HasAttribute("AGStateVersion", Guild) == False)
		$AddAttribute(Guild, "AGStateVersion", "integer", 0);
	$Adventurer_Guild_Activities_Ensure(Guild);
end


function Adventurer_Guild_Is_Open(agent Guild) is boolean
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	return ($GetAttribute(Guild, #ATTRIB_EmbassyActiveFlag) == 1);
end


function Adventurer_Guild_Ensure_Hero_State(agent Hero)
declare
begin
	if ($HasAttribute("AGPendingGuild", Hero) == False)
		$AddAttribute(Hero, "AGPendingGuild", "agentref");

	if ($HasAttribute("AGPendingQuest", Hero) == False)
		$AddAttribute(Hero, "AGPendingQuest", "agentref");

	if ($HasAttribute("AGAcceptedQuest", Hero) == False)
		$AddAttribute(Hero, "AGAcceptedQuest", "agentref");
end


function Adventurer_Guild_Ensure_Quest_State(agent Quest)
declare
begin
	if ($HasAttribute("AGQuestKind", Quest) == False)
		$AddAttribute(Quest, "AGQuestKind", "integer", 0);
	if ($HasAttribute("AGRowKey", Quest) == False)
		$AddAttribute(Quest, "AGRowKey", "integer", 0);
	if ($HasAttribute("AGChartPoint", Quest) == False)
		$AddAttribute(Quest, "AGChartPoint", "coord");

	if ($HasAttribute("AGGuild", Quest) == False)
		$AddAttribute(Quest, "AGGuild", "agentref");

	if ($HasAttribute("AGDestination", Quest) == False)
		$AddAttribute(Quest, "AGDestination", "agentref");

	if ($HasAttribute("AGDestination2", Quest) == False)
		$AddAttribute(Quest, "AGDestination2", "agentref");

	if ($HasAttribute("AGStage", Quest) == False)
		$AddAttribute(Quest, "AGStage", "integer", 0);

	if ($HasAttribute("AGClaimant", Quest) == False)
		$AddAttribute(Quest, "AGClaimant", "agentref");

	if ($HasAttribute("AGApplicant", Quest) == False)
		$AddAttribute(Quest, "AGApplicant", "agentref");

	if ($HasAttribute("AGObjectiveComplete", Quest) == False)
		$AddAttribute(Quest, "AGObjectiveComplete", "boolean", False);

	if ($HasAttribute("AGPaid", Quest) == False)
		$AddAttribute(Quest, "AGPaid", "boolean", False);

	if ($HasAttribute("AGName", Quest) == False)
		$AddAttribute(Quest, "AGName", "string", "Royal Dispatch");

	if ($HasAttribute("AGGoal", Quest) == False)
		$AddAttribute(Quest, "AGGoal", "string", "Carry royal orders");

	if ($HasAttribute("AGReward", Quest) == False)
		$AddAttribute(Quest, "AGReward", "integer", 0);
end


function Adventurer_Guild_Allocate_Row_Key(agent Guild) is integer
declare
	integer Key;
begin
	Key = Guild's "AGNextRowKey";
	if (Key <= 0)
		return 0;
	if (Key == 2147483647)
		Guild's "AGNextRowKey" = 0;
	else
		Guild's "AGNextRowKey" += 1;
	return Key;
end





function Adventurer_Guild_Publish_Rows(agent Guild)
declare
	list Quests, Keys, Kinds, Rewards;
	agent Quest;
	integer Key, ChartIndex;
begin
	if ($IsValidGamePiece(Guild) == False)
		return;
	$Adventurer_Guild_Ensure_Guild_State(Guild);
	Quests = Guild's "AGAvailableQuests";
	foreach Quest in Quests do
		if ($ListSize(Keys) < 64)
			if (Quest != Guild)
			if ($IsValidGamePiece(Quest))
				begin
					$Adventurer_Guild_Ensure_Quest_State(Quest);
					if ((Quest's "AGGuild" == Guild) &&
						(Quest's "AGQuestKind" >= 1) && (Quest's "AGQuestKind" <= 8))
						begin
							Key = Quest's "AGRowKey";
							if (Key <= 0)
								begin
									Key = $Adventurer_Guild_Allocate_Row_Key(Guild);
									Quest's "AGRowKey" = Key;
								end
							if (Key > 0)
								begin
									Keys << Key;
									Kinds << Quest's "AGQuestKind";
									Rewards << Quest's "AGReward";
								end
						end
				end
	ChartIndex = 1;
	while ((ChartIndex <= $ListSize(Guild's "AGChartKeys")) && ($ListSize(Keys) < 64)) do
		begin
			Keys << $ListMember(Guild's "AGChartKeys", ChartIndex);
			Kinds << 4;
			Rewards << 200;
			ChartIndex += 1;
		end
	ChartIndex = 1;
	while ((ChartIndex <= $ListSize(Guild's "AGXKeys")) && ($ListSize(Keys) < 64)) do
		begin
			Keys << $ListMember(Guild's "AGXKeys", ChartIndex);
			Kinds << $ListMember(Guild's "AGXKinds", ChartIndex);
			Rewards << $ListMember(Guild's "AGXRewards", ChartIndex);
			ChartIndex += 1;
		end
	Guild's "AGUIRowKeys" = Keys;
	Guild's "AGUIRowKinds" = Kinds;
	Guild's "AGUIRowRewards" = Rewards;
	Guild's "AGUIReady" = True;
	Guild's "AGRevision" += 1;
end


function Adventurer_Guild_Birth(agent ThisAgent)
declare
begin
	$Adventurer_Guild_Ensure_Guild_State(ThisAgent);



	$NewThread(ThisAgent's "ActiveScript", 500, ThisAgent);
	$Building_Birth(ThisAgent);



	$SetAttribute(ThisAgent, #ATTRIB_EmbassyActiveFlag, 0);
	$Adventurer_Guild_Refresh_Offers(ThisAgent);
end


function Adventurer_Guild_Poll(agent ThisAgent)
declare
begin
	if ($IsValidGamePiece(ThisAgent) == False)
		return;

	$Adventurer_Guild_Ensure_Guild_State(ThisAgent);


	$Adventurer_Guild_Prune_Quest_Lists(ThisAgent);

	if (ThisAgent's "AGUIReady" == False)
		$Adventurer_Guild_Publish_Rows(ThisAgent);
end


function Adventurer_Guild_Target_In_Use(agent Guild, agent Destination) is boolean
declare
	list Quests;
	agent Quest;
	agent Owner;
	boolean TargetInUse;
begin
	if ($Adventurer_Guild_Activity_Target_In_Use(Guild, Destination))
		return True;
	TargetInUse = False;
	if ($HasAttribute("AGGuild", Destination))
		begin
			Owner = Destination's "AGGuild";
			if ($IsValidGamePiece(Owner))
				begin
					if ($HasAttribute("AGAvailableQuests", Owner))
						begin
							Quests = Owner's "AGAvailableQuests";
							foreach Quest in Quests do
								if ($IsValidGamePiece(Quest))
									if ((Quest == Destination) ||
										(($HasAttribute("AGDestination", Quest)) &&
										(Quest's "AGDestination" == Destination)))
										TargetInUse = True;
						end
					if ($HasAttribute("AGActiveQuests", Owner))
						begin
							Quests = Owner's "AGActiveQuests";
							foreach Quest in Quests do
								if ($IsValidGamePiece(Quest))
									if ((Quest == Destination) ||
										(($HasAttribute("AGDestination", Quest)) &&
										(Quest's "AGDestination" == Destination)))
										TargetInUse = True;
						end
				end
		end

	Quests = Guild's "AGAvailableQuests";
	foreach Quest in Quests do
		if ($IsValidGamePiece(Quest))
			if ((Quest == Destination) ||
				(($HasAttribute("AGDestination", Quest)) &&
				(Quest's "AGDestination" == Destination)))
				TargetInUse = True;

	Quests = Guild's "AGActiveQuests";
	foreach Quest in Quests do
		if ($IsValidGamePiece(Quest))
			if ((Quest == Destination) ||
				(($HasAttribute("AGDestination", Quest)) &&
				(Quest's "AGDestination" == Destination)))
				TargetInUse = True;

	return TargetInUse;
end


function Adventurer_Guild_Destination_Valid(
	agent Guild,
	agent Destination
) is boolean
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsValidGamePiece(Destination) == False)
		return False;
	if ($IsDead(Destination))
		return False;
	if ($UnitsAreSamePlayer(Guild, Destination) == False)
		return False;
	return True;
end


function Adventurer_Guild_Lair_Target_Valid(
	agent Guild,
	agent Lair
) is boolean




declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsValidGamePiece(Lair) == False)
		return False;
	if ($IsDead(Lair))
		return False;
	if (Lair's "type" != "lair")
		return False;
	if ($GetPlayerTeamNumber(Guild) == $GetPlayerTeamNumber(Lair))
		return False;
	return True;
end


function Adventurer_Guild_Scout_Offer_Valid(agent Guild, agent Lair) is boolean



declare
	list SeenLairs;
begin
	if ($Adventurer_Guild_Lair_Target_Valid(Guild, Lair) == False)
		return False;
	$ListObjects(Guild, "lair", -1, SeenLairs, #NotMyTeam);
	return ($AgentInList(Lair, SeenLairs) == False);
end


function Adventurer_Guild_Scout_Candidates(agent Guild) is list



declare
	list Lairs;
	list SeenLairs;
	list Candidates;
	agent Lair;
begin
	$ListObjects(Guild, "lair", -1, Lairs, #NoHiddenMap, #NotMyTeam);
	$ListObjects(Guild, "lair", -1, SeenLairs, #NotMyTeam);
	foreach Lair in Lairs do
		if ($AgentInList(Lair, SeenLairs) == False)
			if ($Adventurer_Guild_Lair_Target_Valid(Guild, Lair))
				if ($Adventurer_Guild_Target_In_Use(Guild, Lair) == False)
					Candidates << Lair;
	return Candidates;
end


function Adventurer_Guild_Treasure_Target_Valid(agent Guild, agent Chest) is boolean
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsValidGamePiece(Chest) == False)
		return False;
	if ($IsDead(Chest))
		return False;
	if ((Chest's "Type" != "Special_Item") || (Chest's "Title" != "Treasure_Chest"))
		return False;
	if ($GetAttribute(Chest, #ATTRIB_HP) <= 0)
		return False;
	return ($GetAttribute(Chest, #ATTRIB_Gold) > 0);
end


function Adventurer_Guild_Treasure_Candidates(agent Guild) is list
declare
	list Items, SeenItems, Candidates;
	agent Chest;
begin

	$ListObjects(Guild, "Special_Item", -1, Items, #NoHiddenMap);
	$ListObjects(Guild, "Special_Item", -1, SeenItems);
	foreach Chest in Items do
		if ($AgentInList(Chest, SeenItems) == False)
			if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Chest))
				if ($Adventurer_Guild_Target_In_Use(Guild, Chest) == False)
					Candidates << Chest;
	return Candidates;
end


function Adventurer_Guild_Monster_Target_Valid(
	agent Guild,
	agent Monster
) is boolean




declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsValidGamePiece(Monster) == False)
		return False;
	if ($IsDead(Monster))
		return False;
	if (Monster's "type" != "monster")
		return False;
	if ($GetPlayerTeamNumber(Guild) == $GetPlayerTeamNumber(Monster))
		return False;
	return True;
end


function Adventurer_Guild_Monster_Was_Zoo_Captured(
	agent Guild,
	agent Monster
) is boolean







declare
	agent Zoo;
begin
	if (($IsValidGamePiece(Guild) == False) ||
		($IsValidGamePiece(Monster) == False) ||
		($IsDead(Monster)))
		return False;
	if (Monster's "subtype" != "Hooligan")
		return False;
	if ((Monster's "type" != "Hidden") &&
		(Monster's "type" != "Hooligan"))
		return False;

	Zoo = Monster's "Target";
	if ($IsValidGamePiece(Zoo) == False)
		return False;
	if ((Zoo's "type" != "building") || (Zoo's "title" != "Zoo"))
		return False;
	if ($UnitsAreSamePlayer(Guild, Zoo) == False)
		return False;
	return True;
end


function Adventurer_Guild_Threat_Rank(agent Monster) is integer




declare
	integer Experience;
begin
	Experience = $GetAttribute(Monster, #ATTRIB_LevelXP);

	if (Experience <= 230)
		return 1;
	else if (Experience <= 400)
		return 2;
	else if (Experience <= 500)
		return 3;
	else if (Experience <= 900)
		return 4;
	else if (Experience <= 1500)
		return 5;
	else if (Experience <= 2000)
		return 6;
	else if (Experience <= 3500)
		return 7;

	return 8;
end


function Adventurer_Guild_Monster_Bounty_Reward(agent Monster) is integer
declare
begin
	if ($IsValidGamePiece(Monster) == False)
		return 0;
	return $Adventurer_Guild_Threat_Rank(Monster) * 100;
end


function Adventurer_Guild_Economy_Building_Valid(
	agent Guild,
	agent Building
) is boolean





declare
begin
	if ($Adventurer_Guild_Destination_Valid(Guild, Building) == False)
		return False;
	if (Building's "type" != "building")
		return False;
	if ($GetAttribute(Building, #ATTRIB_FirstStageBuilt) != 1)
		return False;
	if ((Building's "title" == "Marketplace") ||
		(Building's "title" == "Blacksmith") ||
		(Building's "title" == "Inn"))
		return True;
	if ($HasAttribute("EconomyBuilding", Building))



		return True;
	return False;
end


function Adventurer_Guild_Supply_Run_Objectives_Valid(
	agent Guild,
	agent Quest
) is boolean
declare
	agent Destination1;
	agent Destination2;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;
	if ($HasAttribute("AGDestination2", Quest) == False)
		return False;

	Destination1 = Quest's "AGDestination";
	Destination2 = Quest's "AGDestination2";
	if ($Adventurer_Guild_Economy_Building_Valid(
		Guild,
		Destination1
	) == False)
		return False;
	if ($Adventurer_Guild_Economy_Building_Valid(
		Guild,
		Destination2
	) == False)
		return False;
	if (Destination1's "title" == Destination2's "title")
		return False;
	return True;
end


function Adventurer_Guild_Patrol_Building_Valid(agent Guild, agent Building) is boolean
declare
begin
	if ($Adventurer_Guild_Destination_Valid(Guild, Building) == False)
		return False;
	if (Building's "type" != "building")
		return False;
	if ($GetAttribute(Building, #ATTRIB_FirstStageBuilt) != 1)
		return False;


	if (Building's "title" == "Palace")
		return False;
	return ((Building's "title" == "Guardhouse") ||
		(Building's "title" == "Ballista_Tower") ||
		(Building's "title" == "Wizards_Tower") ||
		(Building's "title" == "Dwarven_Settlement") ||
		(Building's "subtype" == "Outpost"));
end


function Adventurer_Guild_Patrol_Objectives_Valid(agent Guild, agent Quest) is boolean
declare
	agent Destination1, Destination2;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;
	if ($HasAttribute("AGDestination2", Quest) == False)
		return False;
	Destination1 = Quest's "AGDestination";
	Destination2 = Quest's "AGDestination2";
	if ($Adventurer_Guild_Patrol_Building_Valid(Guild, Destination1) == False)
		return False;
	if ($Adventurer_Guild_Patrol_Building_Valid(Guild, Destination2) == False)
		return False;
	if (Destination1 == Destination2)
		return False;
	return ($DistanceBetweenAgents(Destination1, Destination2) >=
		#Adventurer_Guild_Patrol_Min_Distance);
end


function Adventurer_Guild_Two_Stop_Objectives_Valid(agent Guild, agent Quest) is boolean
declare
begin
	if (Quest's "AGQuestKind" == 8)
		return $Adventurer_Guild_Patrol_Objectives_Valid(Guild, Quest);
	return $Adventurer_Guild_Supply_Run_Objectives_Valid(Guild, Quest);
end


function Adventurer_Guild_Patrol_Candidates(agent Guild) is list



declare
	list Buildings, Eligible, Candidates;
	agent Building, Destination1, Destination2;
	boolean Found;
begin
	$ListObjects(Guild, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);
	foreach Building in Buildings do
		if ($Adventurer_Guild_Patrol_Building_Valid(Guild, Building))
			if ($Adventurer_Guild_Target_In_Use(Guild, Building) == False)
				Eligible << Building;
	foreach Destination1 in Eligible do
		begin
			Found = False;
			foreach Destination2 in Eligible do
				if ((Found == False) && (Destination1 != Destination2))
					if ($DistanceBetweenAgents(Destination1, Destination2) >=
						#Adventurer_Guild_Patrol_Min_Distance)
						Found = True;
			if (Found)
				Candidates << Destination1;
		end
	return Candidates;
end


function Adventurer_Guild_Available_Quest_Valid(
	agent Guild,
	agent Quest
) is boolean
declare
	integer Kind;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;
	$Adventurer_Guild_Ensure_Quest_State(Quest);
	if (Quest's "AGGuild" != Guild)
		return False;
	Kind = Quest's "AGQuestKind";
	if ((Kind < 1) || (Kind > 8))
		return False;
	if ($IsValidGamePiece(Quest's "AGClaimant"))
		return False;
	if ((Quest's "AGObjectiveComplete") || (Quest's "AGPaid"))
		return False;
	if (Kind == 4)
		return ((Quest == Guild) &&
			$Adventurer_Guild_Chart_Unexplored(Guild, Quest's "AGChartPoint"));
	if (Kind == 2)
		return $Adventurer_Guild_Lair_Target_Valid(
			Guild,
			Quest's "AGDestination"
		);
	if (Kind == 3)
		return $Adventurer_Guild_Monster_Target_Valid(
			Guild,
			Quest's "AGDestination"
		);
	if (Kind == 5)
		return $Adventurer_Guild_Supply_Run_Objectives_Valid(Guild, Quest);
	if (Kind == 8)
		return $Adventurer_Guild_Patrol_Objectives_Valid(Guild, Quest);
	if (Kind == 6)
		return $Adventurer_Guild_Treasure_Target_Valid(Guild, Quest's "AGDestination");
	if (Kind == 7)
		return $Adventurer_Guild_Scout_Offer_Valid(
			Guild,
			Quest's "AGDestination"
		);
	return $Adventurer_Guild_Destination_Valid(
		Guild,
		Quest's "AGDestination"
	);
end


function Adventurer_Guild_Active_Quest_Valid(
	agent Guild,
	agent Quest
) is boolean
declare
	integer Kind;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;
	$Adventurer_Guild_Ensure_Quest_State(Quest);
	if (Quest's "AGGuild" != Guild)
		return False;
	Kind = Quest's "AGQuestKind";
	if ((Kind >= 9) && (Kind <= 16))
		return $Adventurer_Guild_Activity_Active_Valid(Guild, Quest);
	if ((Kind < 1) || (Kind > 8))
		return False;
	if ($IsValidGamePiece(Quest's "AGClaimant") == False)
		return False;
	if (Quest's "AGPaid")
		return False;
	if (Kind == 4)
		return (Quest == Quest's "AGClaimant");
	if (Kind == 6)
		begin
			if (Quest's "AGObjectiveComplete")
				return True;
			return $Adventurer_Guild_Treasure_Target_Valid(Guild, Quest's "AGDestination");
		end
	if ((Kind == 2) || (Kind == 7))
		begin
			if (Quest's "AGObjectiveComplete")
				return True;
			return $Adventurer_Guild_Lair_Target_Valid(
				Guild,
				Quest's "AGDestination"
			);
		end
	if (Kind == 3)
		begin
			if (Quest's "AGObjectiveComplete")
				return True;
			if ($Adventurer_Guild_Monster_Target_Valid(
				Guild,
				Quest's "AGDestination"
			))
				return True;
			return $Adventurer_Guild_Monster_Was_Zoo_Captured(
				Guild,
				Quest's "AGDestination"
			);
		end
	if (Kind == 5)
		return $Adventurer_Guild_Supply_Run_Objectives_Valid(Guild, Quest);
	if (Kind == 8)
		begin
			if (Quest's "AGObjectiveComplete")
				return True;
			return $Adventurer_Guild_Patrol_Objectives_Valid(Guild, Quest);
		end
	return $Adventurer_Guild_Destination_Valid(
		Guild,
		Quest's "AGDestination"
	);
end


function Adventurer_Guild_Prune_Quest_Lists(agent Guild)




declare
	list Available;
	list KeptAvailable;
	list Active;
	list KeptActive;
	agent Quest;
	boolean Changed;
begin
	if ($IsValidGamePiece(Guild) == False)
		return;
	$Adventurer_Guild_Ensure_Guild_State(Guild);
	$Adventurer_Guild_Chart_Prune(Guild);
	$Adventurer_Guild_Activities_Prune(Guild);
	Changed = False;

	Available = Guild's "AGAvailableQuests";
	foreach Quest in Available do
		if ($Adventurer_Guild_Available_Quest_Valid(Guild, Quest))
			KeptAvailable << Quest;
		else
			begin
				Changed = True;
				if ($IsValidGamePiece(Quest))
					$Adventurer_Guild_Detach_Quest(Quest);
			end
	Guild's "AGAvailableQuests" = KeptAvailable;

	Active = Guild's "AGActiveQuests";
	foreach Quest in Active do
		begin
			if ($IsValidGamePiece(Quest))
				if ($HasAttribute("AGQuestKind", Quest))
					if (Quest's "AGQuestKind" == 12)
						$Adventurer_Guild_Pests_Update(Quest);




			if ($IsValidGamePiece(Quest))
				if ($HasAttribute("AGQuestKind", Quest))
					if (Quest's "AGQuestKind" == 3)
						if ($Adventurer_Guild_Monster_Was_Zoo_Captured(
							Guild,
							Quest's "AGDestination"
						))
							$Adventurer_Guild_Resolve_Zoo_Capture(Quest);
		if ($Adventurer_Guild_Active_Quest_Valid(Guild, Quest))
			KeptActive << Quest;
		else
			begin
				Changed = True;
				if ($IsValidGamePiece(Quest))
					$Adventurer_Guild_Fail_Quest(Quest);
			end
		end
	Guild's "AGActiveQuests" = KeptActive;

	if (Changed)
		$Adventurer_Guild_Publish_Rows(Guild);
end


function Adventurer_Guild_Supply_Run_Can_Generate(agent Guild) is boolean
declare
	list Buildings;
	agent Destination1;
	agent Destination2;
	boolean Found;
begin
	Found = False;
	$ListObjects(Guild, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);

	foreach Destination1 in Buildings do
		if ($Adventurer_Guild_Economy_Building_Valid(Guild, Destination1))
			if ($Adventurer_Guild_Target_In_Use(Guild, Destination1) == False)
				foreach Destination2 in Buildings do
					if (Destination2 != Destination1)
						if (Destination2's "title" != Destination1's "title")
							if ($Adventurer_Guild_Economy_Building_Valid(
								Guild,
								Destination2
							))
								if ($Adventurer_Guild_Target_In_Use(
									Guild,
									Destination2
								) == False)
									Found = True;

	return Found;
end


function Adventurer_Guild_Cleanse_Den_Can_Generate(agent Guild) is boolean




declare
	list Lairs;
	agent Lair;
	boolean Found;
begin
	Found = False;
	$ListObjects(Guild, "lair", -1, Lairs, #NotMyTeam);
	foreach Lair in Lairs do
		if ($Adventurer_Guild_Lair_Target_Valid(Guild, Lair))
			if ($Adventurer_Guild_Target_In_Use(Guild, Lair) == False)
				Found = True;
	return Found;
end


function Adventurer_Guild_Monster_Bounty_Can_Generate(agent Guild) is boolean




declare
	list Monsters;
	agent Monster;
	boolean Found;
begin
	Found = False;
	$ListObjects(Guild, "monster", -1, Monsters, #NotMyTeam);
	foreach Monster in Monsters do
		if ($Adventurer_Guild_Monster_Target_Valid(Guild, Monster))
			if ($Adventurer_Guild_Target_In_Use(Guild, Monster) == False)
				Found = True;
	return Found;
end


function Adventurer_Guild_Scout_Can_Generate(agent Guild) is boolean
declare
	list Candidates;
begin
	Candidates = $Adventurer_Guild_Scout_Candidates(Guild);
	return ($ListSize(Candidates) > 0);
end


function Adventurer_Guild_Reward_For(
	agent Guild,
	agent Destination
) is integer
declare
	integer Distance;
begin
	Distance = $DistanceBetweenAgents(Guild, Destination);
	if (Distance >= 1500)
		return 300;
	if (Distance >= 750)
		return 200;
	return 100;
end


function Adventurer_Guild_Quest_Kind_In_Use(
	agent Guild,
	integer Kind
) is boolean
declare
	list Quests;
	agent Quest;
	boolean Found;
begin
	Found = False;
	Quests = Guild's "AGAvailableQuests";
	foreach Quest in Quests do
		if ($IsValidGamePiece(Quest))
			if ($HasAttribute("AGQuestKind", Quest))
				if (Quest's "AGQuestKind" == Kind)
					Found = True;

	return Found;
end


function Adventurer_Guild_Select_Unused_Quest_Kind(
	agent Guild,
	boolean AllowSupplyRun,
	boolean AllowCleanseDen,
	boolean AllowMonsterBounty,
	boolean AllowScout
) is integer
declare
	integer Attempts;
	integer Kind;
begin



	Attempts = 0;
	while (Attempts < 32) do
		begin
			Kind = $RandomNumber(8) + 1;
			if ((Kind != 4) && (Kind != 6) && (Kind != 8) && ((Kind != 5) || (AllowSupplyRun)))
				if ((Kind != 2) || (AllowCleanseDen))
					if ((Kind != 3) || (AllowMonsterBounty))
						if ((Kind != 7) || (AllowScout))
							if ($Adventurer_Guild_Quest_Kind_In_Use(Guild, Kind) == False)
								return Kind;
			Attempts += 1;
		end

	Kind = 1;
	while (Kind <= 8) do
		begin
			if ((Kind != 4) && (Kind != 6) && (Kind != 8) && ((Kind != 5) || (AllowSupplyRun)))
				if ((Kind != 2) || (AllowCleanseDen))
					if ((Kind != 3) || (AllowMonsterBounty))
						if ((Kind != 7) || (AllowScout))
							if ($Adventurer_Guild_Quest_Kind_In_Use(Guild, Kind) == False)
								return Kind;
			Kind += 1;
		end

	return 0;
end


function Adventurer_Guild_Configure_Placeholder_Quest(
	agent Guild,
	agent Quest,
	integer Kind
) is boolean
declare
	integer RowKey;
begin

	if (Kind == 4)
		return False;
	if (Kind == 2)
		begin
			if ($Adventurer_Guild_Lair_Target_Valid(Guild, Quest) == False)
				return False;
		end
	else if (Kind == 3)
		begin
			if ($Adventurer_Guild_Monster_Target_Valid(Guild, Quest) == False)
				return False;
		end
	else if (Kind == 7)
		begin
			if ($Adventurer_Guild_Scout_Offer_Valid(Guild, Quest) == False)
				return False;
		end
	else if (Kind == 6)
		begin
			if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Quest) == False)
				return False;
		end
	else if (Kind == 8)
		begin
			if ($Adventurer_Guild_Patrol_Building_Valid(Guild, Quest) == False)
				return False;
		end
	else
		if ($Adventurer_Guild_Destination_Valid(Guild, Quest) == False)
			return False;

	RowKey = $Adventurer_Guild_Allocate_Row_Key(Guild);
	if (RowKey <= 0)
		return False;
	$Adventurer_Guild_Ensure_Quest_State(Quest);
	Quest's "AGRowKey" = RowKey;
	Quest's "AGQuestKind" = Kind;
	Quest's "AGGuild" = Guild;
	Quest's "AGDestination" = Quest;
	Quest's "AGDestination2" = $NullAgent();
	Quest's "AGStage" = 0;
	Quest's "AGClaimant" = $NullAgent();
	Quest's "AGApplicant" = $NullAgent();
	Quest's "AGObjectiveComplete" = False;
	Quest's "AGPaid" = False;

	if (Kind == 1)
		begin
			Quest's "AGName" = "Royal Dispatch";
			Quest's "AGGoal" = "Deliver royal orders";
			Quest's "AGReward" = 100;
			return True;
		end
	if (Kind == 2)
		begin
			Quest's "AGName" = "Cleanse the Den";
			Quest's "AGGoal" = "Destroy a hostile lair";
			Quest's "AGReward" = 600;
			return True;
		end
	if (Kind == 3)
		begin
			Quest's "AGName" = "Monster Bounty";
			Quest's "AGGoal" = "Defeat the marked monster";
			Quest's "AGReward" =
				$Adventurer_Guild_Monster_Bounty_Reward(Quest);
			return True;
		end
	if (Kind == 5)
		begin
			Quest's "AGName" = "Supply Run";
			Quest's "AGGoal" = "Collect city supplies";
			Quest's "AGReward" = 150;
			return True;
		end
	if (Kind == 6)
		begin
			Quest's "AGName" = "Lost Treasure";
			Quest's "AGGoal" = "Find a hidden treasure chest";
			Quest's "AGReward" = 100;
			return True;
		end
	if (Kind == 7)
		begin
			Quest's "AGName" = "Scout the Lair";
			Quest's "AGGoal" = "Discover a hidden lair";
			Quest's "AGReward" = 300;
			return True;
		end
	if (Kind == 8)
		begin
			Quest's "AGName" = "Border Patrol";
			Quest's "AGGoal" = "Patrol two outposts";
			Quest's "AGReward" = 300;
			return True;
		end

	Quest's "AGQuestKind" = 0;
	Quest's "AGGuild" = $NullAgent();
	Quest's "AGDestination" = $NullAgent();
	Quest's "AGDestination2" = $NullAgent();
	Quest's "AGStage" = 0;
	Quest's "AGReward" = 0;
	return False;
end


function Adventurer_Guild_Create_Supply_Run(agent Guild) is agent




declare
	list Buildings;
	list FirstCandidates;
	list SecondCandidates;
	agent Destination;
	agent Destination1;
	agent Destination2;
	agent Quest;
	integer Pick;
begin
	$ListObjects(Guild, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);

	foreach Destination in Buildings do
		if ($Adventurer_Guild_Economy_Building_Valid(Guild, Destination))
			if ($Adventurer_Guild_Target_In_Use(Guild, Destination) == False)
				FirstCandidates << Destination;

	if ($ListSize(FirstCandidates) == 0)
		return $NullAgent();
	Pick = $RandomNumber($ListSize(FirstCandidates)) + 1;
	Destination1 = $ListMember(FirstCandidates, Pick);

	foreach Destination in Buildings do
		if (Destination != Destination1)
			if (Destination's "title" != Destination1's "title")
				if ($Adventurer_Guild_Economy_Building_Valid(Guild, Destination))
					if ($Adventurer_Guild_Target_In_Use(Guild, Destination) == False)
						SecondCandidates << Destination;

	if ($ListSize(SecondCandidates) == 0)
		return $NullAgent();
	Pick = $RandomNumber($ListSize(SecondCandidates)) + 1;
	Destination2 = $ListMember(SecondCandidates, Pick);

	Quest = Destination1;
	if ($Adventurer_Guild_Configure_Placeholder_Quest(
		Guild,
		Quest,
		5
	) == False)
		return $NullAgent();
	Quest's "AGDestination2" = Destination2;
	Quest's "AGStage" = 0;
	Guild's "AGAvailableQuests" << Quest;
	return Quest;
end


function Adventurer_Guild_Create_Patrol(agent Guild) is agent


declare
	list Candidates, SecondCandidates;
	agent Destination1, Destination2, Quest;
	integer Pick;
begin
	Candidates = $Adventurer_Guild_Patrol_Candidates(Guild);
	if ($ListSize(Candidates) == 0)
		return $NullAgent();
	Pick = $RandomNumber($ListSize(Candidates)) + 1;
	Destination1 = $ListMember(Candidates, Pick);
	foreach Destination2 in Candidates do
		if (Destination2 != Destination1)
			if ($DistanceBetweenAgents(Destination1, Destination2) >=
				#Adventurer_Guild_Patrol_Min_Distance)
				SecondCandidates << Destination2;
	if ($ListSize(SecondCandidates) == 0)
		return $NullAgent();
	Pick = $RandomNumber($ListSize(SecondCandidates)) + 1;
	Destination2 = $ListMember(SecondCandidates, Pick);
	Quest = Destination1;
	if ($Adventurer_Guild_Configure_Placeholder_Quest(Guild, Quest, 8) == False)
		return $NullAgent();
	Quest's "AGDestination2" = Destination2;
	Quest's "AGStage" = 0;
	Guild's "AGAvailableQuests" << Quest;
	return Quest;
end


function Adventurer_Guild_Create_Cleanse_Den(agent Guild) is agent




declare
	list Lairs;
	list Candidates;
	agent Lair;
	agent Quest;
	integer Pick;
begin
	$ListObjects(Guild, "lair", -1, Lairs, #NotMyTeam);
	foreach Lair in Lairs do
		if ($Adventurer_Guild_Lair_Target_Valid(Guild, Lair))
			if ($Adventurer_Guild_Target_In_Use(Guild, Lair) == False)
				Candidates << Lair;

	if ($ListSize(Candidates) == 0)
		return $NullAgent();

	Pick = $RandomNumber($ListSize(Candidates)) + 1;
	Quest = $ListMember(Candidates, Pick);
	if ($Adventurer_Guild_Configure_Placeholder_Quest(
		Guild,
		Quest,
		2
	) == False)
		return $NullAgent();

	Guild's "AGAvailableQuests" << Quest;
	return Quest;
end


function Adventurer_Guild_Create_Monster_Bounty(agent Guild) is agent





declare
	list Monsters;
