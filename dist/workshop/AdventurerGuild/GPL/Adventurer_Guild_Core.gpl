			if ($Adventurer_Guild_Target_In_Use(Guild, Monster) == False)
				Candidates << Monster;

	if ($ListSize(Candidates) == 0)
		return $NullAgent();

	Pick = $RandomNumber($ListSize(Candidates)) + 1;
	Quest = $ListMember(Candidates, Pick);
	if ($Adventurer_Guild_Configure_Placeholder_Quest(
		Guild,
		Quest,
		3
	) == False)
		return $NullAgent();

	Guild's "AGAvailableQuests" << Quest;
	return Quest;
end


