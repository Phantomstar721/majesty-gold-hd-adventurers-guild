function Adventurer_Guild_Create_Dispatch(
	agent Guild,
	agent Destination,
	integer Kind
) is agent
declare
	agent Quest;
begin
	if ($Adventurer_Guild_Destination_Valid(Guild, Destination) == False)
		return $NullAgent();





	Quest = Destination;
	if ($Adventurer_Guild_Configure_Placeholder_Quest(
		Guild,
		Quest,
		Kind
	) == False)
		return $NullAgent();
	Guild's "AGAvailableQuests" << Quest;

	return Quest;
end


function Adventurer_Guild_Delete_Available(agent Guild)
declare
	list Quests;
	agent Quest;
	agent Applicant;
begin
	$Adventurer_Guild_Activities_Clear(Guild);
	Quests = Guild's "AGAvailableQuests";
	foreach Quest in Quests do
		if ($IsValidGamePiece(Quest))
			begin
				$Adventurer_Guild_Ensure_Quest_State(Quest);
				if ($HasAttribute("AGGuild", Quest))
				if (Quest's "AGGuild" == Guild)
					begin
						Applicant = Quest's "AGApplicant";
						if ($IsValidGamePiece(Applicant))
							$Adventurer_Guild_Remove_Applicant(Guild, Applicant);
						Quest's "AGQuestKind" = 0;
						Quest's "AGGuild" = $NullAgent();
						Quest's "AGDestination" = $NullAgent();
						Quest's "AGDestination2" = $NullAgent();
						Quest's "AGStage" = 0;
						Quest's "AGClaimant" = $NullAgent();
						Quest's "AGApplicant" = $NullAgent();
						Quest's "AGObjectiveComplete" = False;
						Quest's "AGPaid" = False;
						Quest's "AGReward" = 0;
					end
			end

	$ClearList(Guild's "AGAvailableQuests");
	$ClearList(Guild's "AGChartKeys");
	$ClearList(Guild's "AGChartPoints");
end


function Adventurer_Guild_Refresh_Offers(agent Guild) is boolean
declare
	list Buildings;
	list Candidates;
	list TreasureCandidates;
	list PatrolCandidates;
	list FallbackKinds;
	agent Destination;
	agent Quest;
	integer Kind;
	integer Pick;
	integer Posted;
	integer OrdinarySlots;
	boolean AllowSupplyRun;
	boolean IncludeSupplyRun;
	boolean AllowCleanseDen;
	boolean IncludeCleanseDen;
	boolean AllowMonsterBounty;
	boolean IncludeMonsterBounty;
	boolean AllowScout;
	boolean IncludeScout;
	boolean IncludePatrol;
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;

	$Adventurer_Guild_Ensure_Guild_State(Guild);
	if ($Adventurer_Guild_Activities_Batch_Ready())
		return $Adventurer_Guild_Activities_Refresh(Guild);
	$Adventurer_Guild_Delete_Available(Guild);
	Guild's "AGProofOfferVisible" = True;





	$ListObjects(Guild, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);

	foreach Destination in Buildings do
		if (Destination != Guild)
			if (Destination's "title" != "Adventurer_Guild")
				if ($Adventurer_Guild_Target_In_Use(Guild, Destination) == False)
					Candidates << Destination;

	AllowSupplyRun = $Adventurer_Guild_Supply_Run_Can_Generate(Guild);
	IncludeSupplyRun = False;
	if (AllowSupplyRun)
		if ($RandomNumber(2) == 0)
			IncludeSupplyRun = True;
		else
			FallbackKinds << 5;
	AllowCleanseDen = $Adventurer_Guild_Cleanse_Den_Can_Generate(Guild);
	IncludeCleanseDen = False;
	if (AllowCleanseDen)
		if ($RandomNumber(2) == 0)
			IncludeCleanseDen = True;
		else
			FallbackKinds << 2;
	AllowMonsterBounty = $Adventurer_Guild_Monster_Bounty_Can_Generate(Guild);
	IncludeMonsterBounty = False;
	if (AllowMonsterBounty)
		if ($RandomNumber(2) == 0)
			IncludeMonsterBounty = True;
		else
			FallbackKinds << 3;
	AllowScout = $Adventurer_Guild_Scout_Can_Generate(Guild);
	IncludeScout = False;
	if (AllowScout)
		if ($RandomNumber(2) == 0)
			IncludeScout = True;
		else
			FallbackKinds << 7;
	PatrolCandidates = $Adventurer_Guild_Patrol_Candidates(Guild);
	IncludePatrol = False;
	if ($ListSize(PatrolCandidates) > 0)
		if ($RandomNumber(2) == 0)
			IncludePatrol = True;
		else
			FallbackKinds << 8;





	Posted = 0;
	if (IncludeSupplyRun)
		begin
			Quest = $Adventurer_Guild_Create_Supply_Run(Guild);
			if ($IsValidGamePiece(Quest))
				begin
					Candidates -= Quest;
					Posted = 1;
				end
		end
	if (IncludeCleanseDen)
		begin
			Quest = $Adventurer_Guild_Create_Cleanse_Den(Guild);
			if ($IsValidGamePiece(Quest))
				Posted += 1;
		end
	if (IncludeMonsterBounty)
		begin
			Quest = $Adventurer_Guild_Create_Monster_Bounty(Guild);
			if ($IsValidGamePiece(Quest))
				Posted += 1;
		end
	if (IncludeScout)
		begin
			Quest = $Adventurer_Guild_Create_Scout(Guild);
			if ($IsValidGamePiece(Quest))
				Posted += 1;
		end
	if (Posted < #Adventurer_Guild_Offers_Per_Refresh)
		if (IncludePatrol)
			begin
				Quest = $Adventurer_Guild_Create_Patrol(Guild);
				if ($IsValidGamePiece(Quest))
					begin
						Candidates -= Quest;
						Posted += 1;
					end
			end
	if (Posted < #Adventurer_Guild_Offers_Per_Refresh)
		begin
			TreasureCandidates = $Adventurer_Guild_Treasure_Candidates(Guild);
			if ($ListSize(TreasureCandidates) > 0)
				if ($RandomNumber(2) == 0)
					begin
						Quest = $Adventurer_Guild_Create_Treasure(Guild, TreasureCandidates);
						if ($IsValidGamePiece(Quest))
							Posted += 1;
					end
				else
					FallbackKinds << 6;
		end

	if (Posted < #Adventurer_Guild_Offers_Per_Refresh)
		if ($RandomNumber(2) == 0)
			begin
				if ($Adventurer_Guild_Create_Chart(Guild))
					Posted += 1;
			end
		else
			FallbackKinds << 4;







	OrdinarySlots = $ListSize(Candidates);
	if (OrdinarySlots > 1)
		OrdinarySlots = 1;
	while (((Posted + OrdinarySlots) < #Adventurer_Guild_Offers_Per_Refresh) && ($ListSize(FallbackKinds) > 0)) do
		begin
			Pick = $RandomNumber($ListSize(FallbackKinds)) + 1;
			Kind = $ListMember(FallbackKinds, Pick);
			FallbackKinds -= Kind;
			Quest = $NullAgent();
			if (Kind == 5)
				Quest = $Adventurer_Guild_Create_Supply_Run(Guild);
			else if (Kind == 8)
				Quest = $Adventurer_Guild_Create_Patrol(Guild);
			else if (Kind == 2)
				Quest = $Adventurer_Guild_Create_Cleanse_Den(Guild);
			else if (Kind == 3)
				Quest = $Adventurer_Guild_Create_Monster_Bounty(Guild);
			else if (Kind == 7)
				Quest = $Adventurer_Guild_Create_Scout(Guild);
			else if (Kind == 6)
				Quest = $Adventurer_Guild_Create_Treasure(Guild, TreasureCandidates);
			else if (Kind == 4)
				if ($Adventurer_Guild_Create_Chart(Guild))
					Quest = Guild;
			if ($IsValidGamePiece(Quest))
				begin
					Candidates -= Quest;
					Posted += 1;
				end
			OrdinarySlots = $ListSize(Candidates);
			if (OrdinarySlots > 1)
				OrdinarySlots = 1;
		end

	while (($ListSize(Candidates) > 0) && (Posted < #Adventurer_Guild_Offers_Per_Refresh)) do
		begin
			Kind = $Adventurer_Guild_Select_Unused_Quest_Kind(
				Guild,
				False,
				False,
				False,
				False
			);
			if (Kind == 0)
				begin

					$Adventurer_Guild_Publish_Rows(Guild);
					return (Posted > 0);
				end
			Pick = $RandomNumber($ListSize(Candidates)) + 1;
			Destination = $ListMember(Candidates, Pick);
			Candidates -= Destination;
			Quest = $Adventurer_Guild_Create_Dispatch(
				Guild,
				Destination,
				Kind
			);
			if ($IsValidGamePiece(Quest))
				Posted += 1;
		end

	$Adventurer_Guild_Publish_Rows(Guild);
	if (Posted > 0)
		return True;
	return False;
end


function Adventurer_Guild_Scheduled_Refresh(agent Guild, integer Generation)





declare
begin
end


function Adventurer_Guild_Quest_Executable(
	agent Hero,
	agent Guild,
	agent Quest
) is boolean



declare
begin
	if (($IsValidGamePiece(Hero) == False) ||
		($IsValidGamePiece(Guild) == False) ||
		($IsValidGamePiece(Quest) == False))
		return False;
	if ($UnitsAreSamePlayer(Hero, Guild) == False)
		return False;
	if ($HasAttribute("AGQuestKind", Quest) == False)
		return False;
	if ((Quest's "AGQuestKind" != 1) &&
		(Quest's "AGQuestKind" != 2) &&
		(Quest's "AGQuestKind" != 3) &&
		(Quest's "AGQuestKind" != 4) &&
		(Quest's "AGQuestKind" != 5) &&
		(Quest's "AGQuestKind" != 6) &&
		(Quest's "AGQuestKind" != 7) &&
		(Quest's "AGQuestKind" != 8))
		return False;
	if (Quest's "AGGuild" != Guild)
		return False;
	if (Quest's "AGPaid")
		return False;
	if (Quest's "AGObjectiveComplete")
		return False;
	if ($IsValidGamePiece(Quest's "AGClaimant"))
		return False;
	if ($IsValidGamePiece(Quest's "AGApplicant"))
		if (Quest's "AGApplicant" != Hero)
			return False;
	if (Quest's "AGQuestKind" == 4)
		return ((Quest == Guild) &&
			$Adventurer_Guild_Chart_Unexplored(Guild, Quest's "AGChartPoint"));
	if (Quest's "AGQuestKind" == 2)
		begin
			if ($Adventurer_Guild_Lair_Target_Valid(
				Guild,
				Quest's "AGDestination"
			) == False)
				return False;
		end
	else
	if (Quest's "AGQuestKind" == 3)
		begin
			if ($Adventurer_Guild_Monster_Target_Valid(
				Guild,
				Quest's "AGDestination"
			) == False)
				return False;
		end
	else
	if (Quest's "AGQuestKind" == 6)
		begin
			if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Quest's "AGDestination") == False)
				return False;
		end
	else
	if (Quest's "AGQuestKind" == 7)
		begin
			if ($Adventurer_Guild_Scout_Offer_Valid(
				Guild,
				Quest's "AGDestination"
			) == False)
				return False;
		end
	else
	if ((Quest's "AGQuestKind" == 5) || (Quest's "AGQuestKind" == 8))
		begin
			if ($Adventurer_Guild_Two_Stop_Objectives_Valid(
				Guild,
				Quest
			) == False)
				return False;
		end
	else
		if ($Adventurer_Guild_Destination_Valid(
			Guild,
			Quest's "AGDestination"
		) == False)
			return False;
	return True;
end


function Adventurer_Guild_Offer_Value(
	agent Hero,
	agent Guild,
	agent Quest
) is integer
declare
	integer Reward;
begin
	if ($Adventurer_Guild_Quest_Executable(Hero, Guild, Quest) == False)
		return 0;

	Reward = Quest's "AGReward";
	if (Reward <= 0)
		return 0;





	return Reward;
end


function Adventurer_Guild_Best_Offer(agent Guild, agent Hero) is agent
declare
	list Quests;
	agent Quest;
	agent BestQuest;
	integer BestScore;
	integer Score;
begin
	BestScore = 0;
	Quests = Guild's "AGAvailableQuests";

	foreach Quest in Quests do
		begin
			Score = $Adventurer_Guild_Offer_Value(Hero, Guild, Quest);
			if (Score > BestScore)
				begin
					BestScore = Score;
					BestQuest = Quest;
				end
		end

	return BestQuest;
end


function Adventurer_Guild_Remove_Applicant(agent Guild, agent Hero)
declare
	agent Quest;
begin
	if ($IsValidGamePiece(Guild))
		if ($HasAttribute("AGApplicants", Guild))
			Guild's "AGApplicants" -= Hero;

	if ($IsValidGamePiece(Hero))
		begin
			if ($HasAttribute("AGPendingQuest", Hero))
				begin
					Quest = Hero's "AGPendingQuest";
					if ($IsValidGamePiece(Quest))
						if ($HasAttribute("AGApplicant", Quest))
							if (Quest's "AGApplicant" == Hero)
								Quest's "AGApplicant" = $NullAgent();
					Hero's "AGPendingQuest" = $NullAgent();
				end
			if ($HasAttribute("AGPendingGuild", Hero))
				Hero's "AGPendingGuild" = $NullAgent();
			if ($HasAttribute("AGXPendingKey", Hero))
				Hero's "AGXPendingKey" = 0;
		end
end


function Adventurer_Guild_Intent(agent Hero, integer Phase)
declare
	agent Quest;
	integer Kind;
begin
	if ((Phase == 1) || (Phase == 3))
		$SpecifyIntent(Hero, #Intent_Going_To_Adventurers_Guild);
	else
		if (Phase == 2)
			begin


				Kind = 0;
				if ($HasAttribute("AGAcceptedQuest", Hero))
					begin
						Quest = Hero's "AGAcceptedQuest";
						if ($IsValidGamePiece(Quest))
							if ($HasAttribute("AGQuestKind", Quest))
								Kind = Quest's "AGQuestKind";
					end


				if (Kind == 1)
					$SpecifyIntent(Hero, #Intent_AG_Royal_Dispatch);
				else if (Kind == 2)
					$SpecifyIntent(Hero, #Intent_AG_Cleanse_Den);
				else if (Kind == 3)
					$SpecifyIntent(Hero, #Intent_AG_Monster_Bounty);
				else if (Kind == 4)
					$SpecifyIntent(Hero, #Intent_AG_Chart_Wilds);
				else if (Kind == 5)
					$SpecifyIntent(Hero, #Intent_AG_Supply_Run);
				else if (Kind == 6)
					$SpecifyIntent(Hero, #Intent_AG_Lost_Treasure);
				else if (Kind == 7)
					$SpecifyIntent(Hero, #Intent_AG_Scout_Lair);
				else if (Kind == 8)
					$SpecifyIntent(Hero, #Intent_AG_Border_Patrol);
				else if (Kind == 9)
					$SpecifyIntent(Hero, #Intent_AG_Answer_Call);
				else if (Kind == 10)
					$SpecifyIntent(Hero, #Intent_AG_Watch_Back);
				else if (Kind == 11)
					$SpecifyIntent(Hero, #Intent_AG_Caravan_Guard);
				else if (Kind == 12)
					$SpecifyIntent(Hero, #Intent_AG_Pest_Control);
				else if (Kind == 13)
					$SpecifyIntent(Hero, #Intent_AG_Field_Testing);
				else if (Kind == 14)
					$SpecifyIntent(Hero, #Intent_AG_Hold_Line);
				else if (Kind == 15)
					$SpecifyIntent(Hero, #Intent_AG_Tournament);
				else if (Kind == 16)
					$SpecifyIntent(Hero, #Intent_AG_Trade_Route);
				else
					$SpecifyIntent(Hero, #Intent_Performing_A_Quest);
			end
end


function Adventurer_Guild_Start_Application(
	agent Hero,
	agent Guild,
	agent Quest
) is boolean
declare
	boolean CanFindPath;
	float Cost;
begin
	if (($IsValidGamePiece(Hero) == False) ||
		($IsValidGamePiece(Guild) == False) ||
		($IsValidGamePiece(Quest) == False))
		return False;
	if ($Adventurer_Guild_Is_Open(Guild) == False)
		return False;

	$Adventurer_Guild_Ensure_Hero_State(Hero);
	$Adventurer_Guild_Ensure_Guild_State(Guild);
	if ($Adventurer_Guild_Quest_Executable(Hero, Guild, Quest) == False)
		return False;
	if ($AgentInList(Quest, Guild's "AGAvailableQuests") == False)
		return False;




	if (Quest's "AGQuestKind" == 4)
		if ($InsideBuilding(Hero) == False)
			begin
				CanFindPath = False;
				Cost = $PathCost($LocationOf(Hero), Quest's "AGChartPoint",
					"check_buildings", CanFindPath, Hero);
				if (CanFindPath == False)
					return False;
			end



	Hero's "AGPendingGuild" = Guild;
	Hero's "AGPendingQuest" = Quest;
	Quest's "AGApplicant" = Hero;
	Hero's "Target" = Guild;
	Hero's "TaskName" = "AdventurerGuildClaim";
	Hero's "ActiveScript" = $Use_Building;

	if ($AgentInList(Hero, Guild's "AGApplicants") == False)
		Guild's "AGApplicants" << Hero;

	$Adventurer_Guild_Intent(Hero, 1);
	return True;
end


function Adventurer_Guild_Consider(agent Hero) is boolean
declare
	list Buildings;
	list Guilds;
	agent Guild;
	agent Quest;
	agent BestGuild;
	agent BestQuest;
	integer Score;
	integer BestScore;
	integer ActivityKey, ActivityIndex, BestActivityKey;
begin
	$Adventurer_Guild_Ensure_Hero_State(Hero);

	if ($IsValidGamePiece(Hero's "AGAcceptedQuest"))
		return False;
	if ($IsValidGamePiece(Hero's "AGPendingGuild"))
		return False;




	if ($RandomNumber(100) + 1 > 60)
		return False;

	$ListObjects(Hero, "building", -1, Buildings, #MyPlayer);
	Buildings = $ListCompleted(Buildings);
	Guilds = $ListTitles(Buildings, "Adventurer_Guild");
	BestScore = 0;
	BestActivityKey = 0;

	foreach Guild in Guilds do
		begin
			$Adventurer_Guild_Ensure_Guild_State(Guild);
			if ($Adventurer_Guild_Is_Open(Guild))
				if ($DistanceBetweenAgents(Hero, Guild) < #Fairgrounds_Attraction_Range)
					if ($ListSize(Guild's "AGActiveQuests") < 4)
				begin
					Quest = $Adventurer_Guild_Best_Offer(Guild, Hero);
					if ($IsValidGamePiece(Quest))
						begin
							Score = $Adventurer_Guild_Offer_Value(Hero, Guild, Quest);
							if (Score > BestScore)
								begin
									BestScore = Score;
									BestGuild = Guild;
									BestQuest = Quest;
									BestActivityKey = 0;
								end
						end
					ActivityKey = $Adventurer_Guild_Activity_Best_Key(Guild, Hero);
					if (ActivityKey > 0)
						begin
							ActivityIndex = $Adventurer_Guild_Activity_Index(Guild, ActivityKey);
							Score = $ListMember(Guild's "AGXRewards", ActivityIndex);
							if (Score > BestScore)
								begin
									BestScore = Score;
									BestGuild = Guild;
									BestQuest = $NullAgent();
									BestActivityKey = ActivityKey;
								end
						end
				end
		end

	if (BestActivityKey > 0)
		return $Adventurer_Guild_Activity_Start_Application(BestGuild, BestActivityKey, Hero);
	if (($IsValidGamePiece(BestGuild)) && ($IsValidGamePiece(BestQuest)))
		return $Adventurer_Guild_Start_Application(Hero, BestGuild, BestQuest);

	return False;
end


function Adventurer_Guild_Assign_Outbound(agent Hero, agent Quest) is boolean
declare
	agent Destination;
	agent Guild;
	integer Kind;
	coordinate Point;
	boolean CanFindPath;
	float Cost;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;

	Guild = Quest's "AGGuild";
	Kind = Quest's "AGQuestKind";
	if ((Kind >= 9) && (Kind <= 16))
		return $Adventurer_Guild_Activity_Assign(Hero);
	Destination = Quest's "AGDestination";
	if (Kind == 6)
		begin
			if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Destination) == False)
				return False;
			Hero's "Target" = Destination;
			Hero's "TaskName" = "AdventurerGuildTreasure";
			Hero's "ActiveScript" = $Adventurer_Guild_Treasure_Grab_Item;
			Hero's "BackScript" = $Adventurer_Guild_Treasure_Grab_Item;
			$Adventurer_Guild_Intent(Hero, 2);
			return True;
		end
	if ((Kind == 2) || (Kind == 3))
		begin



			if (Kind == 2)
				begin
					if ($Adventurer_Guild_Lair_Target_Valid(
						Guild,
						Destination
					) == False)
						return False;
				end
			else
				if ($Adventurer_Guild_Monster_Target_Valid(
					Guild,
					Destination
				) == False)
					return False;
			Hero's "Target" = Destination;
			if (Kind == 2)
				Hero's "TaskName" = "AdventurerGuildCleanse";
			else
				Hero's "TaskName" = "AdventurerGuildBounty";
			Hero's "ActiveScript" = $Attack_Object;
			$Adventurer_Guild_Intent(Hero, 2);
			return True;
		end
	if (Kind == 4)
		begin
			Point = Quest's "AGChartPoint";
			CanFindPath = False;
			Cost = $PathCost($LocationOf(Hero), Point, "check_buildings", CanFindPath, Hero);
			if (CanFindPath == False)
				return False;
		end
	else if (Kind == 7)
		begin

			if ($Adventurer_Guild_Lair_Target_Valid(Guild, Destination) == False)
				return False;
		end
	else if ((Kind == 5) || (Kind == 8))
		begin
			if ($Adventurer_Guild_Two_Stop_Objectives_Valid(
				Guild,
				Quest
			) == False)
				return False;
			if (Quest's "AGStage" == 1)
				Destination = Quest's "AGDestination2";
			else
				if (Quest's "AGStage" != 0)
					return False;
		end
	else
		if ($Adventurer_Guild_Destination_Valid(Guild, Destination) == False)
			return False;




	Hero's "Target" = Hero;
	if (Kind == 4)
		Hero's "Destination" = Quest's "AGChartPoint";
	else
		Hero's "Destination" = $LocationOf(Destination);
	Hero's "TaskName" = "AdventurerGuildDispatch";
	Hero's "ActiveScript" = $Travel_To;
	Hero's "BackScript" = $Adventurer_Guild_Dispatch_Outbound;
	$Adventurer_Guild_Intent(Hero, 2);
	$Move(Hero, Hero's "Destination");
	return True;
end


function Adventurer_Guild_Treasure_Eval_Items(agent ThisAgent) is boolean
declare
begin

	if (ThisAgent's "BackScript" == $Adventurer_Guild_Treasure_Grab_Item)
		return False;
	return $Eval_Items_Nearby(ThisAgent);
end


function Adventurer_Guild_Treasure_Travel_To(agent ThisAgent)
declare
begin


	if ($has_arrived(ThisAgent, False) == False)
		if ($haslowHP(ThisAgent) == False)
			begin
				if ((ThisAgent's "evaluationscript")(ThisAgent) == False)
					if ($TryTravelSpell(ThisAgent) == False)
						if ($Adventurer_Guild_Treasure_Eval_Items(ThisAgent) == False)
							begin
							end
			end
		else
			begin
				$heal_self(ThisAgent);
			end
end


function Adventurer_Guild_Treasure_Grab_Item(agent Hero)
declare
	agent Quest, Guild, Target;
begin
	Quest = Hero's "AGAcceptedQuest";
	if ($IsValidGamePiece(Quest) == False)
		begin
			$Reset_Tasks(Hero);
			return;
		end
	Guild = Quest's "AGGuild";
	if (($IsValidGamePiece(Guild) == False) ||
		(Quest != Hero) || (Quest's "AGQuestKind" != 6) ||
		(Quest's "AGClaimant" != Hero) || (Quest's "AGPaid"))
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
			return;
		end
	if (($UnitsAreSamePlayer(Hero, Guild) == False) ||
		($AgentInList(Quest, Guild's "AGActiveQuests") == False))
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
			return;
		end
	if (Quest's "AGObjectiveComplete")
		begin
			$Adventurer_Guild_Assign_Return(Hero, Quest);
			return;
		end
	Target = Quest's "AGDestination";
	if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Target) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
			return;
		end
	Hero's "Target" = Target;
	if ($IsAdjacent(Hero, Target) == False)
		begin

			Hero's "ActiveScript" = $Adventurer_Guild_Treasure_Travel_To;
			Hero's "Destination" = $LocationOf(Target);
			Hero's "BackScript" = $Adventurer_Guild_Treasure_Grab_Item;
			$Move(Hero, Target);
			return;
		end



	$Open_Chest(Hero, Target);
	Quest = Hero's "AGAcceptedQuest";
	if ($IsValidGamePiece(Quest) == False)
		return;
	if ((Quest != Hero) || (Quest's "AGQuestKind" != 6) ||
		(Quest's "AGClaimant" != Hero) || (Quest's "AGPaid"))
		return;
	Quest's "AGObjectiveComplete" = True;
	if ($Adventurer_Guild_Assign_Return(Hero, Quest) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
		end
end


function Adventurer_Guild_Assign_Return(agent Hero, agent Quest) is boolean
declare
	agent Guild;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;

	Guild = Quest's "AGGuild";
	if ($IsValidGamePiece(Guild) == False)
		return False;

	Hero's "Target" = Guild;
	Hero's "TaskName" = "AdventurerGuildReturn";
	Hero's "ActiveScript" = $Use_Building;
	$Adventurer_Guild_Intent(Hero, 3);
	return True;
end


function Adventurer_Guild_Claim(agent Guild, agent Hero, agent Quest) is boolean
declare
	agent Target;
	integer Kind;
	integer Index;
	list RemainingKeys, RemainingPoints;
begin
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsValidGamePiece(Hero) == False)
		return False;
	if ($IsValidGamePiece(Quest) == False)
		return False;
	if ($UnitsAreSamePlayer(Hero, Guild) == False)
		return False;
	if ($AgentInList(Quest, Guild's "AGAvailableQuests") == False)
		return False;
	if ($ListSize(Guild's "AGActiveQuests") >= 4)
		return False;
	if ($IsValidGamePiece(Hero's "AGAcceptedQuest"))
		return False;
	if ($Adventurer_Guild_Quest_Executable(Hero, Guild, Quest) == False)
		return False;
	if (Quest's "AGApplicant" != Hero)
		return False;

	Kind = Quest's "AGQuestKind";
	if ((Kind == 2) || (Kind == 3) || (Kind == 4) || (Kind == 6) || (Kind == 7) || (Kind == 8))
		begin
			Target = Quest's "AGDestination";


			if ((Kind == 2) || (Kind == 7))
				begin
					if ($Adventurer_Guild_Lair_Target_Valid(
						Guild,
						Target
					) == False)
						return False;
				end
			else if (Kind == 6)
				begin
					if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Target) == False)
						return False;
				end
			else if (Kind == 3)
				if ($Adventurer_Guild_Monster_Target_Valid(
					Guild,
					Target
				) == False)
					return False;




			$Adventurer_Guild_Ensure_Quest_State(Hero);
			Hero's "AGQuestKind" = Quest's "AGQuestKind";
			Hero's "AGRowKey" = Quest's "AGRowKey";
			if (Kind == 4)
				Hero's "AGChartPoint" = Quest's "AGChartPoint";
			Hero's "AGGuild" = Guild;
			Hero's "AGDestination" = Target;
			Hero's "AGDestination2" = $NullAgent();
			if (Kind == 8)
				Hero's "AGDestination2" = Quest's "AGDestination2";
			Hero's "AGStage" = 0;
			Hero's "AGClaimant" = Hero;
			Hero's "AGApplicant" = $NullAgent();
			Hero's "AGObjectiveComplete" = False;
			Hero's "AGPaid" = False;
			Hero's "AGName" = Quest's "AGName";
			Hero's "AGGoal" = Quest's "AGGoal";
			Hero's "AGReward" = Quest's "AGReward";

			Guild's "AGAvailableQuests" -= Quest;
			Guild's "AGActiveQuests" << Hero;
			Quest's "AGApplicant" = $NullAgent();
			Quest's "AGClaimant" = Hero;
			Hero's "AGAcceptedQuest" = Hero;
			if (Kind == 4)
				begin

					Index = 2;
					while (Index <= $ListSize(Guild's "AGChartKeys")) do
						begin
							RemainingKeys << $ListMember(Guild's "AGChartKeys", Index);
							RemainingPoints << $ListMember(Guild's "AGChartPoints", Index);
							Index += 1;
						end
					Guild's "AGChartKeys" = RemainingKeys;
					Guild's "AGChartPoints" = RemainingPoints;
					$Adventurer_Guild_Chart_Sync_Head(Guild);
				end
			if ((Kind == 2) || (Kind == 3))
				$CreateEffector(
					Target,
					"Adventurer_Guild_Lair_Tracker",
					1,
					"infinite"
				);
			$Adventurer_Guild_Publish_Rows(Guild);
			return True;
		end



	Guild's "AGAvailableQuests" -= Quest;
	Guild's "AGActiveQuests" << Quest;
	Quest's "AGApplicant" = $NullAgent();
	Quest's "AGClaimant" = Hero;
	Hero's "AGAcceptedQuest" = Quest;
	$Adventurer_Guild_Publish_Rows(Guild);
	return True;
end


function Adventurer_Guild_Visited(agent Hero)
declare
	agent Guild;
	agent Quest;
	string VisitTask;
begin
	Guild = Hero's "Target";
	VisitTask = Hero's "TaskName";

	$Enter_Building(Hero, Guild);
	$Adventurer_Guild_Ensure_Hero_State(Hero);
	$Adventurer_Guild_Ensure_Guild_State(Guild);

	if (VisitTask == "AdventurerGuildReturn")
		begin
			$Adventurer_Guild_Complete_Return(Hero, Guild);
			return;
		end

	Quest = Hero's "AGPendingQuest";

	if ($HasAttribute("AGXPendingKey", Hero))
		if (Hero's "AGXPendingKey" > 0)
			begin
				if ($Adventurer_Guild_Activity_Claim(Guild, Hero))
					begin
						$Adventurer_Guild_Remove_Applicant(Guild, Hero);
						$Exit_Building(Hero, Guild);
						if ($Adventurer_Guild_Activity_Assign(Hero) == False)
							begin
								$Adventurer_Guild_Fail_Quest(Hero);
								$Reset_Tasks(Hero);
							end
						return;
					end
				$Adventurer_Guild_Remove_Applicant(Guild, Hero);
				$Exit_Building(Hero, Guild);
				return;
			end

	if ($Adventurer_Guild_Is_Open(Guild))
		if ($IsValidGamePiece(Quest))
			if (Quest's "AGApplicant" == Hero)
				if ($Adventurer_Guild_Quest_Executable(Hero, Guild, Quest))
			begin
				if ($Adventurer_Guild_Claim(Guild, Hero, Quest))
					begin
						$Adventurer_Guild_Remove_Applicant(Guild, Hero);


						$Exit_Building(Hero, Guild);
						Quest = Hero's "AGAcceptedQuest";
						if ($Adventurer_Guild_Assign_Outbound(Hero, Quest) == False)
							begin
								$Adventurer_Guild_Fail_Quest(Quest);
								$Reset_Tasks(Hero);
							end
						return;
					end
			end

	$Adventurer_Guild_Remove_Applicant(Guild, Hero);
	$Exit_Building(Hero, Guild);
end


function Adventurer_Guild_Dispatch_Outbound(agent Hero)
declare
	agent Quest;
	agent Destination;
	integer Kind;
begin
	$Adventurer_Guild_Ensure_Hero_State(Hero);
	Quest = Hero's "AGAcceptedQuest";

	if ($IsValidGamePiece(Quest) == False)
		begin
			$Reset_Tasks(Hero);
			return;
		end
	if ($UnitsAreSamePlayer(Hero, Quest's "AGGuild") == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
			return;
		end

	Kind = Quest's "AGQuestKind";
	Destination = Quest's "AGDestination";
	if (Kind == 4)
		begin
			if ($Adventurer_Guild_Chart_Arrived(Hero, Quest's "AGChartPoint"))
				begin
					Quest's "AGObjectiveComplete" = True;
					if ($Adventurer_Guild_Assign_Return(Hero, Quest))
						return;
				end



			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
			return;
		end
	if (Kind == 7)
		begin
			if ($Adventurer_Guild_Lair_Target_Valid(
				Quest's "AGGuild",
				Destination
			) == False)
				begin
					$Adventurer_Guild_Fail_Quest(Quest);
					$Reset_Tasks(Hero);
					return;
				end
		end
	else if ((Kind == 5) || (Kind == 8))
		begin
			if ($Adventurer_Guild_Two_Stop_Objectives_Valid(
				Quest's "AGGuild",
				Quest
			) == False)
				begin
					$Adventurer_Guild_Fail_Quest(Quest);
					$Reset_Tasks(Hero);
					return;
				end
			if (Quest's "AGStage" == 1)
				Destination = Quest's "AGDestination2";
			else
				if (Quest's "AGStage" != 0)
					begin
						$Adventurer_Guild_Fail_Quest(Quest);
						$Reset_Tasks(Hero);
						return;
					end
		end
	else
		if ($Adventurer_Guild_Destination_Valid(
			Quest's "AGGuild",
			Destination
		) == False)
			begin
				$Adventurer_Guild_Fail_Quest(Quest);
				$Reset_Tasks(Hero);
				return;
			end


	if ($IsAdjacent(Hero, Destination) == False)
		begin
			Hero's "Target" = Hero;
			Hero's "Destination" = $LocationOf(Destination);
			Hero's "ActiveScript" = $Travel_To;
			Hero's "BackScript" = $Adventurer_Guild_Dispatch_Outbound;
			$Move(Hero, Hero's "Destination");
			return;
		end

	if (((Kind == 5) || (Kind == 8)) && (Quest's "AGStage" == 0))
		begin


			Quest's "AGStage" = 1;
			if ($Adventurer_Guild_Assign_Outbound(Hero, Quest) == False)
				begin
					$Adventurer_Guild_Fail_Quest(Quest);
					$Reset_Tasks(Hero);
				end
			return;
		end

	Quest's "AGObjectiveComplete" = True;
	if ((Kind == 7) || (Kind == 8))
		$Adventurer_Guild_Clear_Combat_Target(
			Quest's "AGDestination",
			Quest's "AGGuild",
			Hero
		);
	if ($Adventurer_Guild_Assign_Return(Hero, Quest) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Reset_Tasks(Hero);
		end
end


function Adventurer_Guild_Resume(agent Hero) is boolean
declare
	agent Quest;
	agent Guild;
	agent Destination;
	integer Kind;
begin
	$Adventurer_Guild_Ensure_Hero_State(Hero);
	Quest = Hero's "AGAcceptedQuest";

	if ($IsValidGamePiece(Quest) == False)
		return False;
	if (Quest's "AGClaimant" != Hero)
		begin
			Hero's "AGAcceptedQuest" = $NullAgent();
			return False;
		end
	Guild = Quest's "AGGuild";
	if ($IsValidGamePiece(Guild) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			return False;
		end
	if ($UnitsAreSamePlayer(Hero, Guild) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			return False;
		end

	Kind = Quest's "AGQuestKind";
	if ((Kind >= 9) && (Kind <= 16))
		return $Adventurer_Guild_Activity_Resume(Hero);
	Destination = Quest's "AGDestination";
	if (Kind == 4)
		begin
			if (Quest's "AGObjectiveComplete")
				return $Adventurer_Guild_Assign_Return(Hero, Quest);
			if ($Adventurer_Guild_Assign_Outbound(Hero, Quest))
				return True;
			$Adventurer_Guild_Fail_Quest(Quest);
			return False;
		end
	if (Kind == 6)
		begin
			if (Quest's "AGObjectiveComplete")
				return $Adventurer_Guild_Assign_Return(Hero, Quest);
			if ($Adventurer_Guild_Treasure_Target_Valid(Guild, Destination) == False)
				begin
					$Adventurer_Guild_Fail_Quest(Quest);
					return False;
				end
			return $Adventurer_Guild_Assign_Outbound(Hero, Quest);
		end
	if ((Kind == 2) || (Kind == 3) || (Kind == 7))
		begin
			if (Quest's "AGObjectiveComplete")
				return $Adventurer_Guild_Assign_Return(Hero, Quest);
			if ((Kind == 2) || (Kind == 7))
				begin
					if ($Adventurer_Guild_Lair_Target_Valid(
						Guild,
						Destination
					) == False)
						begin
							$Adventurer_Guild_Fail_Quest(Quest);
							return False;
						end
				end
			else
				begin
					if ($Adventurer_Guild_Monster_Was_Zoo_Captured(
						Guild,
						Destination
					))
						return $Adventurer_Guild_Resolve_Zoo_Capture(Quest);
					if ($Adventurer_Guild_Monster_Target_Valid(
						Guild,
						Destination
					) == False)
						begin
							$Adventurer_Guild_Fail_Quest(Quest);
							return False;
						end
				end
			return $Adventurer_Guild_Assign_Outbound(Hero, Quest);
		end
	if ((Kind == 5) || (Kind == 8))
		begin

			if ((Kind == 8) && (Quest's "AGObjectiveComplete"))
				return $Adventurer_Guild_Assign_Return(Hero, Quest);
			if ($Adventurer_Guild_Two_Stop_Objectives_Valid(
				Guild,
				Quest
			) == False)
				begin
					$Adventurer_Guild_Fail_Quest(Quest);
					return False;
				end
			if (Quest's "AGStage" == 1)
				Destination = Quest's "AGDestination2";
			else
				if (Quest's "AGStage" != 0)
					begin
						$Adventurer_Guild_Fail_Quest(Quest);
						return False;
					end
		end
	else
		if ($Adventurer_Guild_Destination_Valid(Guild, Destination) == False)
			begin
				$Adventurer_Guild_Fail_Quest(Quest);
				return False;
			end

	if (Quest's "AGObjectiveComplete")
		return $Adventurer_Guild_Assign_Return(Hero, Quest);

	return $Adventurer_Guild_Assign_Outbound(Hero, Quest);
end


function Adventurer_Guild_Resume_Application(agent Hero) is boolean
declare
	agent Guild;
	agent Quest;
begin
	if (($HasAttribute("AGPendingGuild", Hero) == False) ||
		($HasAttribute("AGPendingQuest", Hero) == False))
		return False;

	Guild = Hero's "AGPendingGuild";
	if ($HasAttribute("AGXPendingKey", Hero))
		if (Hero's "AGXPendingKey" > 0)
			begin
				if ($Adventurer_Guild_Activity_Start_Application(Guild, Hero's "AGXPendingKey", Hero))
					return True;
				$Adventurer_Guild_Remove_Applicant(Guild, Hero);
				return False;
			end
	Quest = Hero's "AGPendingQuest";
	if (($Adventurer_Guild_Is_Open(Guild) == False) ||
		($IsValidGamePiece(Quest) == False) ||
		($AgentInList(Quest, Guild's "AGAvailableQuests") == False) ||
		(Quest's "AGApplicant" != Hero) ||
		($Adventurer_Guild_Quest_Executable(Hero, Guild, Quest) == False))
		begin
			$Adventurer_Guild_Remove_Applicant(Guild, Hero);
			return False;
		end

	return $Adventurer_Guild_Start_Application(Hero, Guild, Quest);
end


function Adventurer_Guild_Hero_Decision(agent Hero) is boolean



declare
begin
	$Adventurer_Guild_Ensure_Hero_State(Hero);

	if ($IsValidGamePiece(Hero's "AGAcceptedQuest"))
		return $Adventurer_Guild_Resume(Hero);

	if ($IsValidGamePiece(Hero's "AGPendingGuild"))
		if ($Adventurer_Guild_Resume_Application(Hero))
			return True;

	return False;
end


function Adventurer_Guild_Hero_Consider(agent Hero) is boolean




declare
begin
	return $Adventurer_Guild_Consider(Hero);
end


function Adventurer_Guild_Combat_Hero_Nearby(
	agent Target,
	agent Claimant
) is boolean





declare
	list GuysNearby;
	list Rangers;
	list InvisibleHeroes;
	list CamouflagedHeroes;
	list HiddenHeroes;
	agent Guy;
begin
	if ($IsValidGamePiece(Claimant) == False)
		return False;
	if ($IsDead(Claimant))
		return False;

	$ListObjects(Target, "hero", #gold_drop_radius, GuysNearby);
	$ListObjects(
		Target,
		"hero",
		#gold_drop_radius * 2,
		Rangers,
		#CheckTitles,
		"Ranger"
	);
	foreach Guy in Rangers do
		if ($DistanceBetweenAgents(Guy, Target) <=
			$GetAttribute(Guy, #ATTRIB_MaxAttackRange))
			if ($AgentInList(Guy, GuysNearby) == False)
				GuysNearby << Guy;

	$ListObjects(Target, "invisible", #gold_drop_radius, InvisibleHeroes);
	$ListObjects(Target, "Camouflaged", #gold_drop_radius, CamouflagedHeroes);
	HiddenHeroes = $AddLists(InvisibleHeroes, CamouflagedHeroes);
	foreach Guy in HiddenHeroes do
		if (Guy's "subtype" == "hero")
			GuysNearby << Guy;

	GuysNearby = $ListSubtypes(GuysNearby, "Hero");
	return $AgentInList(Claimant, GuysNearby);
end


function Adventurer_Guild_Clear_Combat_Target(
	agent Target,
	agent Guild,
	agent Hero
)
declare
begin
	if ($IsValidGamePiece(Target) == False)
		return;
	if (($HasAttribute("AGGuild", Target) == False) ||
		($HasAttribute("AGClaimant", Target) == False))
		return;
	if ((Target's "AGGuild" != Guild) ||
		(Target's "AGClaimant" != Hero))
		return;

	Target's "AGQuestKind" = 0;
	Target's "AGGuild" = $NullAgent();
	Target's "AGDestination" = $NullAgent();
	Target's "AGDestination2" = $NullAgent();
	Target's "AGStage" = 0;
	Target's "AGClaimant" = $NullAgent();
	Target's "AGApplicant" = $NullAgent();
	Target's "AGObjectiveComplete" = False;
	Target's "AGPaid" = False;
	Target's "AGReward" = 0;
end


function Adventurer_Guild_Resolve_Zoo_Capture(agent Quest) is boolean





declare
	agent Guild;
	agent Hero;
	agent Target;
begin
	if (($IsValidGamePiece(Quest) == False) ||
		($HasAttribute("AGQuestKind", Quest) == False) ||
		(Quest's "AGQuestKind" != 3) ||
		(Quest's "AGObjectiveComplete") ||
		(Quest's "AGPaid"))
		return False;

	Guild = Quest's "AGGuild";
	Hero = Quest's "AGClaimant";
	Target = Quest's "AGDestination";
	if (($IsValidGamePiece(Guild) == False) ||
		($IsValidGamePiece(Hero) == False) ||
		($IsDead(Hero)) ||
		(Quest != Hero) ||
		(Hero's "AGAcceptedQuest" != Quest) ||
		($AgentInList(Quest, Guild's "AGActiveQuests") == False) ||
		($Adventurer_Guild_Monster_Was_Zoo_Captured(
			Guild,
			Target
		) == False))
		return False;

	if (($HasAttribute("AGQuestKind", Target) == False) ||
		(Target's "AGQuestKind" != 3) ||
		(Target's "AGGuild" != Guild) ||
		(Target's "AGClaimant" != Hero))
		return False;

	if ($Adventurer_Guild_Combat_Hero_Nearby(Target, Hero) == False)
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			return False;
		end



	$DeleteEffector(Target, "Adventurer_Guild_Lair_Tracker");
	$Adventurer_Guild_Clear_Combat_Target(Target, Guild, Hero);
	Quest's "AGObjectiveComplete" = True;
	$Adventurer_Guild_Publish_Rows(Guild);
	if ($Adventurer_Guild_Assign_Return(Hero, Quest))
		return True;

	$Adventurer_Guild_Fail_Quest(Quest);
	return False;
end


function Adventurer_Guild_Cleanse_Lair_Callback(agent Target)






declare
	agent Guild;
	agent Hero;
	agent Quest;
	integer Kind;
begin
	if ($IsDead(Target) == False)
		return;
	if ($HasAttribute("AGXPestHero", Target))
		if ($IsValidGamePiece(Target's "AGXPestHero"))
			begin
				$Adventurer_Guild_Pest_Defeated(Target);
				return;
			end
	if (($HasAttribute("AGQuestKind", Target) == False) ||
		($HasAttribute("AGGuild", Target) == False) ||
		($HasAttribute("AGClaimant", Target) == False))
		return;
	Kind = Target's "AGQuestKind";
	if ((Kind != 2) && (Kind != 3))
		return;

	Guild = Target's "AGGuild";
	Hero = Target's "AGClaimant";
	if (($IsValidGamePiece(Guild) == False) ||
		($IsValidGamePiece(Hero) == False) ||
		($IsDead(Hero)))
		return;
	if ($HasAttribute("AGAcceptedQuest", Hero) == False)
		return;
	Quest = Hero's "AGAcceptedQuest";
	if (($IsValidGamePiece(Quest) == False) ||
		(Quest != Hero) ||
		($HasAttribute("AGQuestKind", Quest) == False) ||
		(Quest's "AGQuestKind" != Kind) ||
		(Quest's "AGGuild" != Guild) ||
		(Quest's "AGClaimant" != Hero) ||
		(Quest's "AGDestination" != Target) ||
		($AgentInList(Quest, Guild's "AGActiveQuests") == False))
		return;

	if ($Adventurer_Guild_Combat_Hero_Nearby(Target, Hero))
		begin
			Quest's "AGObjectiveComplete" = True;
			Target's "AGGuild" = $NullAgent();
			Target's "AGClaimant" = $NullAgent();
			$Adventurer_Guild_Publish_Rows(Guild);
			if ($Adventurer_Guild_Assign_Return(Hero, Quest) == False)
				$Adventurer_Guild_Fail_Quest(Quest);
		end
	else
		$Adventurer_Guild_Fail_Quest(Quest);
end


function Adventurer_Guild_Detach_Quest(agent Quest)
declare
	agent Guild;
	agent Hero;
	agent Applicant;
begin
	if ($IsValidGamePiece(Quest) == False)
		return;
	$Adventurer_Guild_Ensure_Quest_State(Quest);

	Guild = Quest's "AGGuild";
	Hero = Quest's "AGClaimant";
	Applicant = Quest's "AGApplicant";
	if ((Quest's "AGQuestKind" >= 9) && (Quest's "AGQuestKind" <= 16))
		$Adventurer_Guild_Activity_Clear_Hero(Quest);

	if ($IsValidGamePiece(Guild))
		begin
			if ($HasAttribute("AGAvailableQuests", Guild))
				Guild's "AGAvailableQuests" -= Quest;
			if ($HasAttribute("AGActiveQuests", Guild))
				Guild's "AGActiveQuests" -= Quest;
			if ($HasAttribute("AGRevision", Guild))
				$Adventurer_Guild_Publish_Rows(Guild);
		end

	if ($IsValidGamePiece(Hero))
		if ($HasAttribute("AGAcceptedQuest", Hero))
			if (Hero's "AGAcceptedQuest" == Quest)
				Hero's "AGAcceptedQuest" = $NullAgent();
	if ($IsValidGamePiece(Applicant))
		$Adventurer_Guild_Remove_Applicant(Guild, Applicant);

	Quest's "AGGuild" = $NullAgent();
	Quest's "AGDestination" = $NullAgent();
	Quest's "AGDestination2" = $NullAgent();
	Quest's "AGStage" = 0;
	Quest's "AGClaimant" = $NullAgent();
	Quest's "AGApplicant" = $NullAgent();
	Quest's "AGObjectiveComplete" = False;
	Quest's "AGPaid" = False;
	Quest's "AGReward" = 0;
end


function Adventurer_Guild_Fail_Quest(agent Quest)
declare
	integer Kind;
	agent Destination;
	agent Guild;
	agent Hero;
begin
	if ($IsValidGamePiece(Quest) == False)
		return;

	$Adventurer_Guild_Ensure_Quest_State(Quest);
	Kind = Quest's "AGQuestKind";
	Destination = Quest's "AGDestination";
	Guild = Quest's "AGGuild";
	Hero = Quest's "AGClaimant";

	if (((Kind == 2) || (Kind == 3)) && (Destination != Quest))
		if ($IsValidGamePiece(Destination))
			begin



				if ($IsDead(Destination) == False)
					$DeleteEffector(
						Destination,
						"Adventurer_Guild_Lair_Tracker"
					);
				$Adventurer_Guild_Clear_Combat_Target(
					Destination,
					Guild,
					Hero
				);
			end


	if (((Kind == 6) || (Kind == 7) || (Kind == 8)) && (Destination != Quest))
		$Adventurer_Guild_Clear_Combat_Target(Destination, Guild, Hero);

	$Adventurer_Guild_Detach_Quest(Quest);



	if (Quest's "type" == "RewardFlag")
		$DeleteGamePiece(Quest);
end


function Adventurer_Guild_Repost_On_Hero_Death(agent Hero, agent Quest) is boolean




declare
	agent Guild;
	agent Destination;
	agent Destination2;
	integer Kind;
	integer Reward;
	integer RowKey;
	string Name;
	string Goal;
	coordinate Point;
begin
	if ($IsValidGamePiece(Quest) == False)
		return False;
	$Adventurer_Guild_Ensure_Quest_State(Quest);
	Guild = Quest's "AGGuild";
	if ($IsValidGamePiece(Guild) == False)
		return False;
	if ($IsDead(Guild))
		return False;
	if ((Quest's "AGClaimant" != Hero) ||
		(Hero's "AGAcceptedQuest" != Quest) ||
		($UnitsAreSamePlayer(Hero, Guild) == False))
		return False;
	if ($AgentInList(Quest, Guild's "AGActiveQuests") == False)
		return False;
	if ((Quest's "AGObjectiveComplete") || (Quest's "AGPaid"))
		return False;
	if ($Adventurer_Guild_Active_Quest_Valid(Guild, Quest) == False)
		return False;

	Kind = Quest's "AGQuestKind";
	if ((Kind >= 9) && (Kind <= 16))
		return $Adventurer_Guild_Activity_Repost(Hero);
	Destination = Quest's "AGDestination";
	if (Kind == 4)
		begin
			Point = Quest's "AGChartPoint";
			if ($Adventurer_Guild_Chart_Unexplored(Guild, Point) == False)
				return False;
			RowKey = Quest's "AGRowKey";
			$Adventurer_Guild_Fail_Quest(Quest);
			Guild's "AGChartKeys" << RowKey;
			Guild's "AGChartPoints" << Point;
			$Adventurer_Guild_Chart_Sync_Head(Guild);
			$Adventurer_Guild_Publish_Rows(Guild);
			return True;
		end


	if (Kind == 3)
		if ($Adventurer_Guild_Monster_Target_Valid(Guild, Destination) == False)
			return False;
	if (Kind == 7)
		if ($Adventurer_Guild_Scout_Offer_Valid(Guild, Destination) == False)
			return False;
	if ((Kind == 2) || (Kind == 3) || (Kind == 6) || (Kind == 7) || (Kind == 8))
		begin
			if (Quest != Hero)
				return False;
			if (($HasAttribute("AGGuild", Destination) == False) ||
				($HasAttribute("AGClaimant", Destination) == False))
				return False;
			if ((Destination's "AGGuild" != Guild) ||
				(Destination's "AGClaimant" != Hero))
				return False;
		end
	else
		if (Quest != Destination)
			return False;
	if ($AgentInList(Destination, Guild's "AGAvailableQuests"))
		return False;




	Destination2 = Quest's "AGDestination2";
	Reward = Quest's "AGReward";
	RowKey = Quest's "AGRowKey";
	Name = Quest's "AGName";
	Goal = Quest's "AGGoal";
	$Adventurer_Guild_Fail_Quest(Quest);



	$Adventurer_Guild_Ensure_Quest_State(Destination);
	Destination's "AGQuestKind" = Kind;
	Destination's "AGRowKey" = RowKey;
	Destination's "AGGuild" = Guild;
	Destination's "AGDestination" = Destination;
	Destination's "AGDestination2" = Destination2;
	Destination's "AGStage" = 0;
	Destination's "AGClaimant" = $NullAgent();
	Destination's "AGApplicant" = $NullAgent();
	Destination's "AGObjectiveComplete" = False;
	Destination's "AGPaid" = False;
	Destination's "AGName" = Name;
	Destination's "AGGoal" = Goal;
	Destination's "AGReward" = Reward;

	Guild's "AGAvailableQuests" << Destination;
	$Adventurer_Guild_Publish_Rows(Guild);
	return True;
end


function Adventurer_Guild_Complete_Return(agent Hero, agent Guild)
declare
	agent Quest;
	integer Reward;
begin
	Quest = Hero's "AGAcceptedQuest";

	if ($IsValidGamePiece(Quest) == False)
		begin
			$Exit_Building(Hero, Guild);
			return;
		end

	if ((Quest's "AGGuild" != Guild) ||
		(Quest's "AGClaimant" != Hero) ||
		($UnitsAreSamePlayer(Hero, Guild) == False) ||
		(Quest's "AGObjectiveComplete" == False) ||
		(Quest's "AGPaid") ||
		($AgentInList(Quest, Guild's "AGActiveQuests") == False))
		begin
			$Adventurer_Guild_Fail_Quest(Quest);
			$Exit_Building(Hero, Guild);
			return;
		end

	Reward = Quest's "AGReward";


	Quest's "AGPaid" = True;
	$Adventurer_Guild_Detach_Quest(Quest);
	$Give_Gold(Hero, Reward);
	$PlaySound(Guild, "completed_reward", "begin");
	$Exit_Building(Hero, Guild);
end


function Adventurer_Guild_Hero_Reset(agent Hero)




declare
	agent Guild;
begin

	if (Hero's "type" != "hero")
		return;

	$Adventurer_Guild_Ensure_Hero_State(Hero);
	Guild = Hero's "AGPendingGuild";
	if ($IsValidGamePiece(Guild))
		$Adventurer_Guild_Remove_Applicant(Guild, Hero);
	else
		Hero's "AGPendingGuild" = $NullAgent();
end


function Adventurer_Guild_Hero_Death(agent Hero)



declare
	agent Guild;
	agent Quest;
begin

	if (Hero's "type" != "hero")
		return;

	$Adventurer_Guild_Ensure_Hero_State(Hero);

	Guild = Hero's "AGPendingGuild";
	if ($IsValidGamePiece(Guild))
		$Adventurer_Guild_Remove_Applicant(Guild, Hero);
	else
		Hero's "AGPendingGuild" = $NullAgent();

	Quest = Hero's "AGAcceptedQuest";
	if ($IsValidGamePiece(Quest))
		begin
			if ($Adventurer_Guild_Repost_On_Hero_Death(Hero, Quest) == False)
				$Adventurer_Guild_Fail_Quest(Quest);
		end
	else
		Hero's "AGAcceptedQuest" = $NullAgent();
end


function Adventurer_Guild_Destroyed(agent Guild)
declare
	list Active;
	agent Hero;
begin
	$Adventurer_Guild_Ensure_Guild_State(Guild);



	$Adventurer_Guild_Delete_Available(Guild);
	Active = Guild's "AGActiveQuests";
	foreach Hero in Active do
		if ($IsValidGamePiece(Hero))
			if ((Hero's "AGQuestKind" >= 9) && (Hero's "AGQuestKind" <= 16))
				$Adventurer_Guild_Fail_Quest(Hero);
	$Building_Death(Guild);
end









function Adventurer_Guild_UI_Offer_Count(agent Guild) is integer
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return 0;
	if ($HasAttribute("AGUIRowKeys", Guild) == False)
		return 0;
	return $ListSize(Guild's "AGUIRowKeys");
end

function Adventurer_Guild_UI_Offer_Key(agent Guild, integer Row) is integer
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return 0;
	if ($HasAttribute("AGUIRowKeys", Guild) == False)
		return 0;
	if ((Row < 1) || (Row > $ListSize(Guild's "AGUIRowKeys")))
		return 0;
	return $ListMember(Guild's "AGUIRowKeys", Row);
end


function Adventurer_Guild_UI_Offer_At(agent Guild, integer Row) is agent
declare
	agent Quest;
begin
	Quest = $NullAgent();
	if ($IsValidGamePiece(Guild) == False)
		return Quest;
	if ($HasAttribute("AGAvailableQuests", Guild) == False)
		return Quest;
	if (Row < 1)
		return Quest;
	if (Row > $ListSize(Guild's "AGAvailableQuests"))
		return Quest;

	Quest = $ListMember(Guild's "AGAvailableQuests", Row);
	if ($IsValidGamePiece(Quest) == False)
		return $NullAgent();
	return Quest;
end

function Adventurer_Guild_UI_Offer_Agent_Id(
	agent Guild,
	integer Row
) is integer
declare
	agent Quest;
begin
	Quest = $Adventurer_Guild_UI_Offer_At(Guild, Row);
	if ($IsValidGamePiece(Quest) == False)
		return 0;
	return $GetAttribute(Quest, #ATTRIB_AgentID);
end

