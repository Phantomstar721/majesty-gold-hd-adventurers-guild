		return 0;
	if ((Row < 1) || (Row > $ListSize(Guild's "AGUIRowRewards")))
		return 0;
	return $ListMember(Guild's "AGUIRowRewards", Row);
end

function Adventurer_Guild_UI_Offer_Variant(agent Guild, integer Row) is integer
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return 0;
	if ($HasAttribute("AGUIRowKinds", Guild) == False)
		return 0;
	if ((Row < 1) || (Row > $ListSize(Guild's "AGUIRowKinds")))
		return 0;
	return $ListMember(Guild's "AGUIRowKinds", Row);
end

function Adventurer_Guild_UI_Revision(agent Guild) is integer
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return 0;
	if ($HasAttribute("AGRevision", Guild) == False)
		return 0;
	return Guild's "AGRevision";
