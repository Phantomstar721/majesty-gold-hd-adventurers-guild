function Adventurer_Guild_UI_Selected_Action_Cost(agent Quest) is integer
declare
begin


	if ($IsValidGamePiece(Quest) == False)
		return 0;
	return 0;
end

function Adventurer_Guild_Find_Offer_Guild(agent Quest) is agent
declare
	list Guilds;
	agent Guild;
	agent QuestGuild;
begin
	QuestGuild = $NullAgent();
	if ($IsValidGamePiece(Quest) == False)
		return QuestGuild;

	$ListObjects(Quest, "building", -1, Guilds, #MyPlayer);
	Guilds = $ListCompleted(Guilds);
	Guilds = $ListTitles(Guilds, "Adventurer_Guild");

	foreach Guild in Guilds do
		if ($HasAttribute("AGAvailableQuests", Guild))
			if ($AgentInList(Quest, Guild's "AGAvailableQuests"))
				QuestGuild = Guild;

	return QuestGuild;
end

function Adventurer_Guild_UI_Reject(agent Quest) is boolean
declare
	agent Guild;
begin
	if ($IsValidGamePiece(Quest))
		if (Quest's "title" == "Adventurer_Guild")
			begin
				$Adventurer_Guild_Ensure_Guild_State(Quest);
				Quest's "AGProofOfferVisible" = False;
				$Adventurer_Guild_Publish_Rows(Quest);
				return True;
			end

	Guild = $Adventurer_Guild_Find_Offer_Guild(Quest);
	if ($IsValidGamePiece(Guild) == False)
		return False;

	Guild's "AGAvailableQuests" -= Quest;
	Guild's "AGProofOfferVisible" = False;
	$Adventurer_Guild_Publish_Rows(Guild);
	return True;
end

function Adventurer_Guild_UI_Refresh_Cost(agent Guild) is integer




declare
begin
	if ($Adventurer_Guild_UI_Can_Refresh(Guild) == 0)
		return 0;
	return 500;
end

function Adventurer_Guild_UI_Can_Refresh(agent Guild) is integer
declare
begin
	if ($IsValidGamePiece(Guild) == False)
		return 0;
	if ($IsDead(Guild))
		return 0;
	if (Guild's "title" != "Adventurer_Guild")
		return 0;
	if ($GetAttribute(Guild, #ATTRIB_FirstStageBuilt) != 1)
		return 0;
	if ($HasAttribute("AGAvailableQuests", Guild) == False)
		return 0;
	return 1;
end

function Adventurer_Guild_UI_Refresh_After_Debit(agent Guild) is boolean





declare
begin
	if ($Adventurer_Guild_UI_Can_Refresh(Guild) == 0)
		return False;
	return $Adventurer_Guild_Refresh_Offers(Guild);
end
