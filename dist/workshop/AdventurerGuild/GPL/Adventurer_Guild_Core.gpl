declare
	list Candidates;
	agent Quest;
	integer Pick;
begin
	Candidates = $Adventurer_Guild_Scout_Candidates(Guild);
	if ($ListSize(Candidates) == 0)
		return $NullAgent();
	Pick = $RandomNumber($ListSize(Candidates)) + 1;
	Quest = $ListMember(Candidates, Pick);
	if ($Adventurer_Guild_Configure_Placeholder_Quest(Guild, Quest, 7) == False)
		return $NullAgent();
